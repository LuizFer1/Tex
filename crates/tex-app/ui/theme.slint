import { Artwork } from "artwork.slint";

export global Tokens {
    in property <color> action: #2e9e3f;
    in property <color> action-strong: #1f7d30;
    in property <color> highlight: #f9c623;
    in property <color> paper: #fffaec;
    in property <color> paper-2: #fbf1cf;
    in property <color> field: #fffdf5;
    in property <color> row-hover: #fdf4d6;
    in property <color> ink: #2a2117;
    in property <color> ink-2: #5a4a2e;
    in property <color> ink-3: #3f3220;
    in property <color> muted: #7a6a48;
    in property <color> muted-2: #a89670;
    in property <color> border: #ead9a8;
    in property <color> border-2: #f0e4bd;
    in property <color> control-off: #a08c5c;
    in property <color> control-off-2: #d9c58d;
    in property <color> warn: #f5a623;
    in property <color> warn-text: #9c6400;
    in property <color> danger: #d6452b;
    in property <color> danger-hover: #b3321b;
    in property <color> danger-bg: #fbe3dc;
    in property <color> on-action: #fffaec;
    in property <color> on-action-muted: #d3ecc9;
    in property <color> selection: #fbe79a;
    in property <color> type-file: #4a7bf7;
    in property <color> type-folder: #f5a623;
    in property <color> type-image: #8b45c9;
    in property <color> type-app: #2e9e3f;
    in property <color> scrollbar: #d9c58d;
    in property <color> banner: #f9c623;
    in property <color> banner-ink: #2a2117;
    in property <color> banner-ink-2: #5a4a2e;
    in property <color> banner-kicker: #6a5410;
    in property <color> close-hover: #c42b1c;
    in property <color> close-hover-ink: #ffffff;
    in property <color> action-tint: #e6f2dc;
    in property <color> shadow: #0000002e;
    in property <color> preview-light-box: #fffaec;
    in property <color> preview-light-ink: #2a2117;
    in property <color> preview-light-line: #ead9a8;
    in property <color> preview-light-background: #fbf1cf;
    in property <color> preview-dark-box: #1f1a14;
    in property <color> preview-dark-ink: #f3ead3;
    in property <color> preview-dark-line: #4a3f2a;
    in property <color> preview-dark-background: #2a241a;

    in property <length> radius-control: 3px;
    in property <length> radius-card: 5px;
    in property <length> radius-tab: 6px;
    in property <length> radius-window: 8px;
    in property <length> radius-art: 16px;
    in property <length> border-control: 1px;
    in property <length> border-strong: 1.5px;
    in property <length> focus-width: 2px;
    in property <length> scrollbar-width: 10px;

    in property <string> ui-font: "Nunito";
    in property <string> mono-font: "IBM Plex Mono";
    in property <length> size-search: 24px;
    in property <length> size-history-input: 18px;
    in property <length> size-title: 20px;
    in property <length> size-banner: 17px;
    in property <length> size-result: 15px;
    in property <length> size-tab: 15px;
    in property <length> size-label: 14px;
    in property <length> size-check: 13.5px;
    in property <length> size-body: 13px;
    in property <length> size-button: 12.5px;
    in property <length> size-desc: 12.5px;
    in property <length> size-path: 12px;
    in property <length> size-meta: 11.5px;
    in property <length> size-kicker: 11px;
    in property <length> size-key: 10.5px;
    in property <length> size-hero: 26px;
    in property <length> size-question: 22px;
    in property <length> size-badge: 10px;

    in property <image> app-icon: Artwork.mascot-icon;
    in property <image> art-search: Artwork.mascot-search;
    in property <image> art-clipboard: Artwork.mascot-clipboard;
    in property <image> art-banner: Artwork.mascot-banner;
    in property <image> art-welcome: Artwork.mascot-welcome;
    in property <image> art-done: Artwork.mascot-done;
}
