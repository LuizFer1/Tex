import { Tokens } from "../theme.slint";
import { Icon } from "icon.slint";

export component Keycap inherits Rectangle {
    in property <string> text;
    in property <bool> large;
    in property <image> icon;
    in property <bool> has-icon;

    property <length> edge: root.large ? Tokens.border-strong : Tokens.border-control;
    property <length> radius: root.large ? 4px : Tokens.radius-control;

    height: root.large ? 38px : 28px;
    min-width: max(root.large ? 38px : 28px, content.min-width);
    border-radius: root.radius;
    background: Tokens.ink;

    Rectangle {
        x: root.edge;
        y: root.edge;
        width: parent.width - 2 * root.edge;
        height: parent.height - root.edge - (root.large ? 4px : 3px);
        border-radius: root.radius - 1px;
        background: Tokens.field;
    }

    content := HorizontalLayout {
        padding-left: root.large ? 12px : 9px;
        padding-right: root.large ? 12px : 9px;
        padding-bottom: root.large ? 3px : 2px;
        if root.has-icon: Icon {
            width: root.large ? 16px : 12px;
            source: root.icon;
            tint: Tokens.ink;
        }
        if !root.has-icon: Text {
            text: root.text;
            font-family: Tokens.mono-font;
            font-size: root.large ? Tokens.size-label : Tokens.size-path;
            font-weight: 500;
            color: Tokens.ink;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
