import { Tokens } from "../theme.slint";

export component Keycap inherits Rectangle {
    in property <string> text;
    height: 28px;
    min-width: max(28px, content.min-width);
    border-radius: Tokens.radius-control;
    background: Tokens.ink;

    Rectangle {
        x: Tokens.border-control;
        y: Tokens.border-control;
        width: parent.width - 2 * Tokens.border-control;
        height: parent.height - Tokens.border-control - 3px;
        border-radius: Tokens.radius-control - 1px;
        background: Tokens.field;
    }

    content := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            font-family: Tokens.mono-font;
            font-size: Tokens.size-path;
            font-weight: 500;
            color: Tokens.ink;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
