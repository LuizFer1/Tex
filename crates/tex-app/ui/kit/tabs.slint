import { Tokens } from "../theme.slint";
import { FocusRing } from "focus.slint";

export component TabItem inherits Rectangle {
    in property <string> text;
    in property <string> number;
    in property <bool> active;
    in property <length> font-size: Tokens.size-body;
    // Side padding. With it the tab also gets a hover background.
    in property <length> pad: 0px;
    // Draws the keyboard focus ring; the tab strip owns the focus.
    in property <bool> focused;
    callback clicked();

    horizontal-stretch: 0;
    accessible-role: tab;
    accessible-label: root.text;

    Rectangle {
        height: parent.height - 2px;
        y: 0px;
        border-top-left-radius: Tokens.radius-control;
        border-top-right-radius: Tokens.radius-control;
        background: root.pad > 0px && touch.has-hover && !root.active ? Tokens.border-2 : transparent;
    }

    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 6px;
        if root.number != "": Text {
            text: root.number;
            font-family: Tokens.mono-font;
            font-size: Tokens.size-kicker;
            color: root.active ? Tokens.action-strong : Tokens.muted;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: 500;
            color: root.active ? Tokens.ink : Tokens.muted;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Tokens.action : transparent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    FocusRing {
        show: root.focused;
    }
}

export component TabBar inherits Rectangle {
    in property <length> padding-x: 20px;
    in property <length> bar-height: 37px;
    height: root.bar-height;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.border;
    }

    HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        spacing: 20px;
        @children
    }
}
