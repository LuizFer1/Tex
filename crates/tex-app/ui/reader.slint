import { ListView, Palette } from "std-widgets.slint";
import { Tokens } from "theme.slint";
import { Icons, TitleButton, Footer, ResizeEdge, Editor, Button, ButtonKind, TextField } from "kit/kit.slint";

export struct ReaderBlock {
    // 0 heading, 1 paragraph, 2 item, 3 code, 4 quote, 5 rule, 6 table row, 7 image
    kind: int,
    level: int,
    marker: string,
    text: styled-text,
    plain: string,
    cells: [styled-text],
    header: bool,
}

component BlockView inherits VerticalLayout {
    in property <ReaderBlock> block;
    callback link-clicked(string);

    padding-left: 32px;
    padding-right: 32px;
    padding-top: root.block.kind == 0 ? (root.block.level <= 2 ? 18px : 12px) : 4px;
    padding-bottom: 4px;

    if root.block.kind == 0: StyledText {
        text: root.block.text;
        default-color: Tokens.ink;
        default-font-size: root.block.level == 1 ? Tokens.size-hero : root.block.level == 2 ? Tokens.size-question : root.block.level == 3 ? Tokens.size-title : Tokens.size-banner;
        link-color: Tokens.type-file;
        link-clicked(link) => {
            root.link-clicked(link);
        }
    }

    if root.block.kind == 1: StyledText {
        text: root.block.text;
        default-color: Tokens.ink;
        default-font-size: Tokens.size-result;
        link-color: Tokens.type-file;
        link-clicked(link) => {
            root.link-clicked(link);
        }
    }

    if root.block.kind == 2: Rectangle {
        height: item-text.preferred-height;
        Text {
            x: (root.block.level - 1) * 22px;
            width: 22px;
            text: root.block.marker;
            color: Tokens.muted;
            font-size: Tokens.size-result;
            horizontal-alignment: right;
            vertical-alignment: top;
        }
        item-text := StyledText {
            x: (root.block.level - 1) * 22px + 28px;
            width: parent.width - self.x;
            text: root.block.text;
            default-color: Tokens.ink;
            default-font-size: Tokens.size-result;
            link-color: Tokens.type-file;
            link-clicked(link) => {
                root.link-clicked(link);
            }
        }
    }

    if root.block.kind == 3: Rectangle {
        background: Tokens.paper-2;
        border-radius: Tokens.radius-card;
        height: code-text.preferred-height + 20px;
        code-text := Text {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            text: root.block.plain;
            font-family: Tokens.mono-font;
            font-size: Tokens.size-body;
            color: Tokens.ink-3;
            wrap: word-wrap;
        }
    }

    if root.block.kind == 4: Rectangle {
        height: quote-text.preferred-height;
        Rectangle {
            x: (root.block.level - 1) * 14px;
            width: 3px;
            background: Tokens.border;
        }
        quote-text := StyledText {
            x: (root.block.level - 1) * 14px + 13px;
            width: parent.width - self.x;
            text: root.block.text;
            default-color: Tokens.ink-2;
            default-font-size: Tokens.size-result;
            link-color: Tokens.type-file;
            link-clicked(link) => {
                root.link-clicked(link);
            }
        }
    }

    if root.block.kind == 5: Rectangle {
        height: 1px;
        background: Tokens.border;
    }

    if root.block.kind == 6: Rectangle {
        background: root.block.header ? Tokens.paper-2 : transparent;
        HorizontalLayout {
            padding: 6px;
            spacing: 12px;
            for cell in root.block.cells: StyledText {
                width: (root.width - 64px - 12px - 12px * (root.block.cells.length - 1)) / root.block.cells.length;
                text: cell;
                default-color: root.block.header ? Tokens.ink : Tokens.ink-2;
                default-font-size: Tokens.size-label;
                link-color: Tokens.type-file;
                link-clicked(link) => {
                    root.link-clicked(link);
                }
            }
        }
    }

    if root.block.kind == 7: Text {
        text: @tr("Image: {0}", root.block.plain);
        color: Tokens.muted;
        font-size: Tokens.size-label;
        font-italic: true;
        wrap: word-wrap;
    }
}

export component ReaderWindow inherits Window {
    title: (root.changed-text ? "• " : "") + root.file-name + " — Tex";
    icon: Tokens.app-icon;
    no-frame: true;
    min-width: 420px;
    min-height: 320px;
    background: Tokens.paper;
    default-font-family: Tokens.ui-font;
    forward-focus: keys;

    in property <ColorScheme> scheme;
    in property <string> file-name;
    in property <string> folder;
    in property <bool> window-maximized;
    in property <bool> markdown;
    in-out property <bool> wrap: true;
    // 0 loading, 1 ready, 2 indexing (first lines shown), 3 failed
    in property <int> state;
    in property <string> error;
    in property <[ReaderBlock]> blocks;
    in property <[string]> lines;
    in property <int> line-count;
    in property <int> longest;
    // 0 UTF-8, 1 UTF-8 with BOM, 2 UTF-16 LE, 3 UTF-16 BE, 4 Windows-1252
    in property <int> encoding;

    callback drag();
    callback resize(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback link-clicked(string);

    in property <bool> dirty;
    in-out property <bool> editing;
    in-out property <string> edit-text;
    in-out property <string> edit-original;
    // 0 none, 1 too large to edit, 2 changed outside, 3 deleted (Ctrl+S recreates it), 4 save failed,
    // 5 characters would be lost, 6 deleted (read-only file)
    in property <int> banner;
    in property <string> banner-detail;
    in-out property <bool> asking-close;
    in-out property <bool> asking-reload;
    in-out property <bool> searching;
    in-out property <string> query;
    in property <int> hit-count;
    in property <int> hit-index: -1;
    in property <bool> search-busy;
    in property <int> current-row: -1;
    property <int> jump-target: -1;
    property <bool> changed-text: root.dirty || (root.editing && root.edit-text != root.edit-original);

    callback edit-requested();
    callback edit-finished();
    callback save-requested();
    // 1 overwrite, 2 reload, 3 save anyway
    callback banner-action(int);
    callback banner-dismissed();
    // 0 save, 1 discard, 2 cancel
    callback close-choice(int);
    callback reload-choice(bool);
    callback search-edited(string);
    callback search-step(bool);
    callback search-closed();

    public function saved() {
        footer.show-toast(@tr("saved"));
    }

    public function jump-to(row: int) {
        root.jump-target = row;
        if root.markdown {
            blocks-list.content-y = max(blocks-list.visible-height - blocks-list.content-height, min(0px, 80px - row * (blocks-list.content-height / max(1, root.blocks.length))));
        } else {
            lines-list.content-y = max(lines-list.visible-height - lines-list.content-height, min(0px, 80px - row * (lines-list.content-height / max(1, root.lines.length))));
        }
    }

    changed editing => {
        if self.editing {
            editor.focus();
        } else if self.searching {
            find.focus();
        } else {
            keys.focus();
        }
    }

    changed searching => {
        if self.searching {
            find.focus();
            find.select-all();
        } else {
            root.jump-target = -1;
            keys.focus();
        }
    }

    changed current-row => {
        if self.current-row < 0 {
            root.jump-target = -1;
        }
    }

    property <string> encoding-name: root.encoding == 0 ? "UTF-8" : root.encoding == 1 ? "UTF-8 BOM" : root.encoding == 2 ? "UTF-16 LE" : root.encoding == 3 ? "UTF-16 BE" : "Windows-1252";
    property <length> char-width: Tokens.size-body * 0.6;

    changed scheme => {
        Palette.color-scheme = self.scheme;
    }

    function reveal-block(y: length) {
        blocks-list.content-y = max(blocks-list.visible-height - blocks-list.content-height, min(0px, 80px - y));
        root.jump-target = -1;
    }

    function reveal-line(y: length) {
        lines-list.content-y = max(lines-list.visible-height - lines-list.content-height, min(0px, 80px - y));
        root.jump-target = -1;
    }

    function scroll-by(delta: length) {
        if root.markdown {
            blocks-list.content-y = max(blocks-list.visible-height - blocks-list.content-height, min(0px, blocks-list.content-y + delta));
        } else {
            lines-list.content-y = max(lines-list.visible-height - lines-list.content-height, min(0px, lines-list.content-y + delta));
        }
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            if root.asking-close {
                if event.text == Key.Escape {
                    root.close-choice(2);
                } else if event.text == Key.Return {
                    root.close-choice(0);
                }
                return accept;
            }
            if root.asking-reload {
                if event.text == Key.Escape || event.text == Key.Return {
                    root.reload-choice(false);
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "s" || event.text == "S") {
                root.save-requested();
                return accept;
            }
            if event.modifiers.control && (event.text == "e" || event.text == "E") {
                if root.editing {
                    root.edit-finished();
                } else {
                    root.edit-requested();
                }
                return accept;
            }
            if root.editing {
                if event.text == Key.Escape {
                    root.edit-finished();
                    return accept;
                }
                return reject;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                root.searching = true;
                return accept;
            }
            if event.text == Key.F3 {
                root.search-step(!event.modifiers.shift);
                return accept;
            }
            if root.searching && event.text == Key.Return {
                root.search-step(!event.modifiers.shift);
                return accept;
            }
            if event.text == Key.Escape {
                if root.searching {
                    root.searching = false;
                    root.search-closed();
                } else {
                    root.close-window();
                }
                return accept;
            }
            if event.modifiers.alt && (event.text == "z" || event.text == "Z") {
                root.wrap = !root.wrap;
                return accept;
            }
            if root.searching && find.has-focus {
                return reject;
            }
            if event.text == Key.DownArrow {
                root.scroll-by(-40px);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.scroll-by(40px);
                return accept;
            }
            if event.text == Key.PageDown {
                root.scroll-by(-(root.height - 120px));
                return accept;
            }
            if event.text == Key.PageUp {
                root.scroll-by(root.height - 120px);
                return accept;
            }
            if event.text == Key.Home {
                root.scroll-by(1000000px);
                return accept;
            }
            if event.text == Key.End {
                root.scroll-by(-1000000000px);
                return accept;
            }
            reject
        }

        Rectangle {
            border-width: root.window-maximized ? 0px : Tokens.border-control;
            border-color: Tokens.border;

            VerticalLayout {
                padding: root.window-maximized ? 0px : Tokens.border-control;

                Rectangle {
                    height: 44px;
                    background: Tokens.paper-2;
                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.drag();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 4px;
                                clip: true;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: Tokens.app-icon;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Tokens.action;
                                        visible: root.changed-text;
                                    }
                                }
                                Text {
                                    text: root.file-name;
                                    font-size: Tokens.size-label;
                                    font-weight: 600;
                                    color: Tokens.ink;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: root.folder;
                                font-family: Tokens.mono-font;
                                font-size: Tokens.size-meta;
                                color: Tokens.muted;
                                overflow: elide;
                            }
                        }
                        TitleButton {
                            icon: Icons.minimize;
                            tip: @tr("Minimize");
                            clicked => {
                                root.minimize();
                            }
                        }
                        TitleButton {
                            icon: root.window-maximized ? Icons.restore : Icons.maximize;
                            tip: root.window-maximized ? @tr("Restore") : @tr("Maximize");
                            clicked => {
                                root.toggle-maximize();
                            }
                        }
                        TitleButton {
                            icon: Icons.close;
                            close: true;
                            tip: @tr("Close");
                            clicked => {
                                root.close-window();
                            }
                        }
                    }
                }

                if root.banner != 0: Rectangle {
                    background: Tokens.banner;
                    HorizontalLayout {
                        padding: 8px;
                        padding-left: 16px;
                        spacing: 8px;
                        Text {
                            text: root.banner == 1 ? @tr("This file is too large to edit in Tex (more than {0} KB).", 128) : root.banner == 2 ? @tr("The file changed outside Tex.") : root.banner == 3 ? @tr("The file no longer exists. Ctrl+S saves it again.") : root.banner == 4 ? @tr("Could not save: {0}", root.banner-detail) : root.banner == 6 ? @tr("The file no longer exists.") : @tr("Some characters cannot be kept in {0}. They will be replaced.", root.encoding-name);
                            color: Tokens.banner-ink;
                            font-size: Tokens.size-label;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if root.banner == 2: VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Overwrite");
                                clicked => {
                                    root.banner-action(1);
                                }
                            }
                        }
                        if root.banner == 2: VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Reload");
                                clicked => {
                                    root.banner-action(2);
                                }
                            }
                        }
                        if root.banner == 5: VerticalLayout {
                            alignment: center;
                            Button {
                                kind: ButtonKind.primary;
                                text: @tr("Save anyway");
                                clicked => {
                                    root.banner-action(3);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            TitleButton {
                                icon: Icons.close;
                                tip: @tr("Close");
                                clicked => {
                                    root.banner-dismissed();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    visible: root.searching;
                    height: root.searching ? search-row.preferred-height : 0px;
                    background: Tokens.paper-2;
                    search-row := HorizontalLayout {
                        padding: 8px;
                        padding-left: 16px;
                        spacing: 12px;
                        find := TextField {
                            boxed: true;
                            mono: true;
                            horizontal-stretch: 1;
                            placeholder: @tr("Find in file");
                            text <=> root.query;
                            edited(text) => {
                                root.search-edited(text);
                            }
                        }
                        Text {
                            text: root.search-busy ? @tr("searching…") : root.query == "" ? "" : root.hit-count == 0 ? @tr("no matches") : @tr("{0} of {1}", root.hit-index + 1, root.hit-count);
                            color: Tokens.muted;
                            font-size: Tokens.size-label;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    blocks-list := ListView {
                        visible: root.markdown && root.state == 1 && !root.editing;
                        for block[index] in root.blocks: Rectangle {
                            property <bool> is-target: index == root.jump-target;
                            height: view.preferred-height;
                            background: index == root.current-row ? Tokens.selection : transparent;
                            init => {
                                if self.is-target {
                                    root.reveal-block(self.y);
                                }
                            }
                            changed is-target => {
                                if self.is-target {
                                    root.reveal-block(self.y);
                                }
                            }
                            view := BlockView {
                                width: parent.width;
                                block: block;
                                link-clicked(link) => {
                                    root.link-clicked(link);
                                }
                            }
                        }
                    }

                    lines-list := ListView {
                        visible: !root.markdown && (root.state == 1 || root.state == 2) && !root.editing;
                        content-width: root.wrap ? self.visible-width : max(self.visible-width, root.longest * root.char-width + 64px);
                        for line[index] in root.lines: Rectangle {
                            property <bool> is-target: index == root.jump-target;
                            width: lines-list.content-width;
                            height: line-text.preferred-height;
                            background: index == root.current-row ? Tokens.selection : transparent;
                            init => {
                                if self.is-target {
                                    root.reveal-line(self.y);
                                }
                            }
                            changed is-target => {
                                if self.is-target {
                                    root.reveal-line(self.y);
                                }
                            }
                            line-text := Text {
                                x: 24px;
                                width: parent.width - 48px;
                                text: line;
                                font-family: Tokens.mono-font;
                                font-size: Tokens.size-body;
                                color: Tokens.ink;
                                wrap: root.wrap ? word-wrap : no-wrap;
                            }
                        }
                    }

                    editor := Editor {
                        visible: root.editing;
                        text <=> root.edit-text;
                        wrap: root.wrap;
                    }

                    if root.state == 0: Text {
                        text: @tr("Loading…");
                        color: Tokens.muted;
                        font-size: Tokens.size-label;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.state == 3: VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        padding: 32px;
                        Text {
                            text: @tr("Could not read this file");
                            color: Tokens.ink;
                            font-size: Tokens.size-title;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.error;
                            color: Tokens.muted;
                            font-size: Tokens.size-label;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                footer := Footer {
                    hints: root.editing ? @tr("ctrl s save · ctrl e or esc stop editing") : @tr("esc close · ctrl e edit · ctrl f find · alt z wrap lines");
                    status: root.state == 2 ? @tr("indexing lines…") : root.state == 1 ? @tr("lines: {0} · {1}", root.line-count, root.encoding-name) : "";
                }
            }
        }

        if root.asking-close: Rectangle {
            background: Tokens.shadow;
            TouchArea {}
            Rectangle {
                width: 420px;
                height: dialog.preferred-height;
                background: Tokens.paper;
                border-radius: Tokens.radius-card;
                border-width: Tokens.border-control;
                border-color: Tokens.border;
                dialog := VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    Text {
                        text: @tr("Save the changes to {0}?", root.file-name);
                        wrap: word-wrap;
                        color: Tokens.ink;
                        font-size: Tokens.size-label;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: @tr("Cancel");
                            clicked => {
                                root.close-choice(2);
                            }
                        }
                        Button {
                            kind: ButtonKind.danger;
                            text: @tr("Discard");
                            clicked => {
                                root.close-choice(1);
                            }
                        }
                        Button {
                            kind: ButtonKind.primary;
                            text: @tr("Save");
                            clicked => {
                                root.close-choice(0);
                            }
                        }
                    }
                }
            }
        }

        if root.asking-reload: Rectangle {
            background: Tokens.shadow;
            TouchArea {}
            Rectangle {
                width: 420px;
                height: reload-dialog.preferred-height;
                background: Tokens.paper;
                border-radius: Tokens.radius-card;
                border-width: Tokens.border-control;
                border-color: Tokens.border;
                reload-dialog := VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    Text {
                        text: @tr("Reload and discard the changes to {0}?", root.file-name);
                        wrap: word-wrap;
                        color: Tokens.ink;
                        font-size: Tokens.size-label;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: @tr("Cancel");
                            clicked => {
                                root.reload-choice(false);
                            }
                        }
                        Button {
                            kind: ButtonKind.danger;
                            text: @tr("Reload");
                            clicked => {
                                root.reload-choice(true);
                            }
                        }
                    }
                }
            }
        }

        if !root.window-maximized: Rectangle {
            ResizeEdge { x: 0px; y: 0px; width: parent.width; height: 6px; direction: 0; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: parent.height - 6px; width: parent.width; height: 6px; direction: 1; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 6px; y: 0px; width: 6px; height: parent.height; direction: 2; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 6px; height: parent.height; direction: 3; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: 0px; width: 10px; height: 10px; direction: 4; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 10px; height: 10px; direction: 5; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; direction: 6; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: parent.height - 10px; width: 10px; height: 10px; direction: 7; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
        }
    }
}
