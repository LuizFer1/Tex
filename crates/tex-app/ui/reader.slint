import { ListView, Palette } from "std-widgets.slint";
import { Tokens } from "theme.slint";
import { Icons, TitleButton, Footer, ResizeEdge } from "kit/kit.slint";

export struct ReaderBlock {
    // 0 heading, 1 paragraph, 2 item, 3 code, 4 quote, 5 rule, 6 table row, 7 image
    kind: int,
    level: int,
    marker: string,
    text: styled-text,
    plain: string,
    cells: [styled-text],
    header: bool,
}

component BlockView inherits VerticalLayout {
    in property <ReaderBlock> block;
    callback link-clicked(string);

    padding-left: 32px;
    padding-right: 32px;
    padding-top: root.block.kind == 0 ? (root.block.level <= 2 ? 18px : 12px) : 4px;
    padding-bottom: 4px;

    if root.block.kind == 0: StyledText {
        text: root.block.text;
        default-color: Tokens.ink;
        default-font-size: root.block.level == 1 ? Tokens.size-hero : root.block.level == 2 ? Tokens.size-question : root.block.level == 3 ? Tokens.size-title : Tokens.size-banner;
        link-color: Tokens.type-file;
        link-clicked(link) => {
            root.link-clicked(link);
        }
    }

    if root.block.kind == 1: StyledText {
        text: root.block.text;
        default-color: Tokens.ink;
        default-font-size: Tokens.size-result;
        link-color: Tokens.type-file;
        link-clicked(link) => {
            root.link-clicked(link);
        }
    }

    if root.block.kind == 2: HorizontalLayout {
        padding-left: (root.block.level - 1) * 22px;
        spacing: 6px;
        Text {
            width: 22px;
            text: root.block.marker;
            color: Tokens.muted;
            font-size: Tokens.size-result;
            horizontal-alignment: right;
        }
        StyledText {
            horizontal-stretch: 1;
            text: root.block.text;
            default-color: Tokens.ink;
            default-font-size: Tokens.size-result;
            link-color: Tokens.type-file;
            link-clicked(link) => {
                root.link-clicked(link);
            }
        }
    }

    if root.block.kind == 3: Rectangle {
        background: Tokens.paper-2;
        border-radius: Tokens.radius-card;
        VerticalLayout {
            padding: 10px;
            Text {
                text: root.block.plain;
                font-family: Tokens.mono-font;
                font-size: Tokens.size-body;
                color: Tokens.ink-3;
                wrap: word-wrap;
            }
        }
    }

    if root.block.kind == 4: HorizontalLayout {
        padding-left: (root.block.level - 1) * 14px;
        spacing: 10px;
        Rectangle {
            width: 3px;
            background: Tokens.border;
        }
        StyledText {
            horizontal-stretch: 1;
            text: root.block.text;
            default-color: Tokens.ink-2;
            default-font-size: Tokens.size-result;
            link-color: Tokens.type-file;
            link-clicked(link) => {
                root.link-clicked(link);
            }
        }
    }

    if root.block.kind == 5: Rectangle {
        height: 1px;
        background: Tokens.border;
    }

    if root.block.kind == 6: Rectangle {
        background: root.block.header ? Tokens.paper-2 : transparent;
        HorizontalLayout {
            padding: 6px;
            spacing: 12px;
            for cell in root.block.cells: StyledText {
                horizontal-stretch: 1;
                text: cell;
                default-color: root.block.header ? Tokens.ink : Tokens.ink-2;
                default-font-size: Tokens.size-label;
                link-color: Tokens.type-file;
                link-clicked(link) => {
                    root.link-clicked(link);
                }
            }
        }
    }

    if root.block.kind == 7: Text {
        text: @tr("Image: {0}", root.block.plain);
        color: Tokens.muted;
        font-size: Tokens.size-label;
        font-italic: true;
        wrap: word-wrap;
    }
}

export component ReaderWindow inherits Window {
    title: root.file-name + " — Tex";
    icon: Tokens.app-icon;
    no-frame: true;
    min-width: 420px;
    min-height: 320px;
    background: Tokens.paper;
    default-font-family: Tokens.ui-font;
    forward-focus: keys;

    in property <ColorScheme> scheme;
    in property <string> file-name;
    in property <string> folder;
    in property <bool> window-maximized;
    in property <bool> markdown;
    in-out property <bool> wrap: true;
    // 0 loading, 1 ready, 2 indexing (first lines shown), 3 failed
    in property <int> state;
    in property <string> error;
    in property <[ReaderBlock]> blocks;
    in property <[string]> lines;
    in property <int> line-count;
    in property <int> longest;
    // 0 UTF-8, 1 UTF-8 with BOM, 2 UTF-16 LE, 3 UTF-16 BE, 4 Windows-1252
    in property <int> encoding;

    callback drag();
    callback resize(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback link-clicked(string);

    property <string> encoding-name: root.encoding == 0 ? "UTF-8" : root.encoding == 1 ? "UTF-8 BOM" : root.encoding == 2 ? "UTF-16 LE" : root.encoding == 3 ? "UTF-16 BE" : "Windows-1252";
    property <length> char-width: Tokens.size-body * 0.6;

    changed scheme => {
        Palette.color-scheme = self.scheme;
    }

    function scroll-by(delta: length) {
        if root.markdown {
            blocks-list.content-y = max(blocks-list.visible-height - blocks-list.content-height, min(0px, blocks-list.content-y + delta));
        } else {
            lines-list.content-y = max(lines-list.visible-height - lines-list.content-height, min(0px, lines-list.content-y + delta));
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-window();
                return accept;
            }
            if event.modifiers.alt && (event.text == "z" || event.text == "Z") {
                root.wrap = !root.wrap;
                return accept;
            }
            if event.text == Key.DownArrow {
                root.scroll-by(-40px);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.scroll-by(40px);
                return accept;
            }
            if event.text == Key.PageDown {
                root.scroll-by(-(root.height - 120px));
                return accept;
            }
            if event.text == Key.PageUp {
                root.scroll-by(root.height - 120px);
                return accept;
            }
            if event.text == Key.Home {
                root.scroll-by(1000000px);
                return accept;
            }
            if event.text == Key.End {
                root.scroll-by(-1000000000px);
                return accept;
            }
            reject
        }

        Rectangle {
            border-width: root.window-maximized ? 0px : Tokens.border-control;
            border-color: Tokens.border;

            VerticalLayout {
                padding: root.window-maximized ? 0px : Tokens.border-control;

                Rectangle {
                    height: 44px;
                    background: Tokens.paper-2;
                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.drag();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 4px;
                                clip: true;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: Tokens.app-icon;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.file-name;
                                font-size: Tokens.size-label;
                                font-weight: 600;
                                color: Tokens.ink;
                                overflow: elide;
                            }
                            Text {
                                text: root.folder;
                                font-family: Tokens.mono-font;
                                font-size: Tokens.size-meta;
                                color: Tokens.muted;
                                overflow: elide;
                            }
                        }
                        TitleButton {
                            icon: Icons.minimize;
                            tip: @tr("Minimize");
                            clicked => {
                                root.minimize();
                            }
                        }
                        TitleButton {
                            icon: root.window-maximized ? Icons.restore : Icons.maximize;
                            tip: root.window-maximized ? @tr("Restore") : @tr("Maximize");
                            clicked => {
                                root.toggle-maximize();
                            }
                        }
                        TitleButton {
                            icon: Icons.close;
                            close: true;
                            tip: @tr("Close");
                            clicked => {
                                root.close-window();
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    blocks-list := ListView {
                        visible: root.markdown && root.state == 1;
                        for block in root.blocks: BlockView {
                            block: block;
                            link-clicked(link) => {
                                root.link-clicked(link);
                            }
                        }
                    }

                    lines-list := ListView {
                        visible: !root.markdown && (root.state == 1 || root.state == 2);
                        content-width: root.wrap ? self.visible-width : max(self.visible-width, root.longest * root.char-width + 64px);
                        for line in root.lines: HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            Text {
                                text: line;
                                font-family: Tokens.mono-font;
                                font-size: Tokens.size-body;
                                color: Tokens.ink;
                                wrap: root.wrap ? word-wrap : no-wrap;
                            }
                        }
                    }

                    if root.state == 0: Text {
                        text: @tr("Loading…");
                        color: Tokens.muted;
                        font-size: Tokens.size-label;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.state == 3: VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        padding: 32px;
                        Text {
                            text: @tr("Could not read this file");
                            color: Tokens.ink;
                            font-size: Tokens.size-title;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.error;
                            color: Tokens.muted;
                            font-size: Tokens.size-label;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                Footer {
                    hints: @tr("esc close · alt z wrap lines");
                    status: root.state == 2 ? @tr("indexing lines…") : root.state == 1 ? @tr("lines: {0} · {1}", root.line-count, root.encoding-name) : "";
                }
            }
        }

        if !root.window-maximized: Rectangle {
            ResizeEdge { x: 0px; y: 0px; width: parent.width; height: 6px; direction: 0; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: parent.height - 6px; width: parent.width; height: 6px; direction: 1; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 6px; y: 0px; width: 6px; height: parent.height; direction: 2; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 6px; height: parent.height; direction: 3; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: 0px; width: 10px; height: 10px; direction: 4; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 10px; height: 10px; direction: 5; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; direction: 6; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: parent.height - 10px; width: 10px; height: 10px; direction: 7; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
        }
    }
}
