import { Tokens } from "theme.slint";
import { Icon, Icons, TextField, TextArea, ScrollBar, TabItem, TabBar, TabbedFrame, Footer, EmptyState, Button, ButtonKind, Kicker } from "kit/kit.slint";

export struct HistoryRow {
    id: string,
    // 0 text, 1 image
    kind: int,
    title: string,
    named: bool,
    favorite: bool,
    unreadable: bool,
    thumbnail: image,
    // 0 today, 1 yesterday, -1 another day
    day: int,
    time: string,
    date-day: int,
    date-month: int,
    date-year: int,
    size-value: string,
    // 0 B, 1 KB, 2 MB, 3 GB
    size-unit: int,
    width: int,
    height: int,
}

export global HistoryText {
    public pure function title(row: HistoryRow) -> string {
        if row.unreadable {
            return @tr("Unreadable entry");
        }
        if row.title != "" {
            return row.title;
        }
        return row.kind == 1 ? @tr("Image") : @tr("Text");
    }

    public pure function size(row: HistoryRow) -> string {
        return self.size-text(row.size-value, row.size-unit);
    }

    public pure function size-text(value: string, unit: int) -> string {
        if unit == 0 {
            return @tr("{0} B", value);
        }
        if unit == 1 {
            return @tr("{0} KB", value);
        }
        if unit == 2 {
            return @tr("{0} MB", value);
        }
        return @tr("{0} GB", value);
    }

    public pure function same-day(a: HistoryRow, b: HistoryRow) -> bool {
        return a.date-day == b.date-day && a.date-month == b.date-month && a.date-year == b.date-year;
    }

    public pure function month(value: int) -> string {
        if value == 1 {
            return @tr("Jan");
        }
        if value == 2 {
            return @tr("Feb");
        }
        if value == 3 {
            return @tr("Mar");
        }
        if value == 4 {
            return @tr("Apr");
        }
        if value == 5 {
            return @tr("May");
        }
        if value == 6 {
            return @tr("Jun");
        }
        if value == 7 {
            return @tr("Jul");
        }
        if value == 8 {
            return @tr("Aug");
        }
        if value == 9 {
            return @tr("Sep");
        }
        if value == 10 {
            return @tr("Oct");
        }
        if value == 11 {
            return @tr("Nov");
        }
        return @tr("Dec");
    }

    public pure function day-label(row: HistoryRow, current-year: int) -> string {
        if row.day == 0 {
            return @tr("Today").to-uppercase();
        }
        if row.day == 1 {
            return @tr("Yesterday").to-uppercase();
        }
        return (row.date-day + " " + self.month(row.date-month) + (row.date-year != current-year ? " " + row.date-year : "")).to-uppercase();
    }
}

export component HistoryWindow inherits Window {
    title: @tr("Clipboard history");
    no-frame: true;
    always-on-top: true;
    width: 640px;
    height: 618px;
    background: Tokens.paper;
    default-font-family: Tokens.ui-font;
    forward-focus: input;

    in property <ColorScheme> scheme;
    in-out property <string> query;
    // 0 all, 1 favorites, 2 text, 3 images
    in-out property <int> filter: 0;
    in property <[HistoryRow]> rows;
    in-out property <int> selected: -1;
    in property <bool> paused;
    in property <string> unavailable;
    in property <bool> searching;
    in property <bool> paste-by-default;
    in property <int> current-year;
    // Day headers above rows 0..=selected, from history::day_starts_through.
    in property <int> selected-headers;
    out property <length> tab-width: frame.tab-width;
    out property <length> tab-height: frame.tab-height;

    // -1 nothing or loading, 0 text, 1 image, 2 unreadable
    in property <int> content-kind: -1;
    in property <string> content-text;
    in property <string> content-preview;
    in property <image> content-image;
    in-out property <bool> renaming;
    in-out property <bool> editing;
    in-out property <bool> confirm-delete;
    // 0 none, 1 too large to save, 2 could not write to the clipboard
    in-out property <int> action-error;

    callback query-edited(string);
    callback filter-changed(int);
    callback step(int);
    callback select(int);
    callback pick(int, bool);
    callback toggle-favorite(int);
    callback rename(int, string);
    callback edit(int, string);
    callback delete(int);
    callback load-more();
    callback dismissed();
    callback open-settings();
    callback toggle-pause();
    callback mask(int);

    changed renaming => {
        if !self.renaming {
            input.focus();
        }
    }
    changed editing => {
        if !self.editing {
            input.focus();
        }
    }
    changed selected => {
        root.expanded = true;
        root.reveal();
    }
    changed selected-height => {
        root.reveal();
    }

    property <length> card-height: 50px;
    property <length> day-height: 30px;
    property <length> selected-height: root.card-height;
    in-out property <bool> expanded: true;
    property <length> current-top: 4px + root.selected *root.card-height + root.selected-headers * root.day-height + list.content-y;
    property <bool> has-selection: root.selected >= 0 && root.selected < root.rows.length;
    property <HistoryRow> current: root.rows[root.selected];
    property <bool> usable: root.has-selection && !root.current.unreadable;
    property <string> rename-draft;
    property <string> edit-draft;
    property <string> primary-action: root.paste-by-default ? @tr("Copy and paste") : @tr("Copy");
    property <string> other-action: root.paste-by-default ? @tr("Copy") : @tr("Copy and paste");
    property <string> primary-action-short: root.paste-by-default ? @tr("copy and paste") : @tr("copy");
    property <string> other-action-short: root.paste-by-default ? @tr("copy") : @tr("copy and paste");

    public function reset() {
        root.query = "";
        root.filter = 0;
        root.selected = -1;
        root.renaming = false;
        root.editing = false;
        root.confirm-delete = false;
        root.action-error = 0;
        root.expanded = true;
        list.content-y = 0;
        input.focus();
    }

    public function scroll-to-top() {
        list.content-y = 0;
    }

    function reveal() {
        if root.selected <= 0 {
            list.content-y = 0;
            return;
        }
        if root.current-top < 0 {
            list.content-y -= root.current-top;
        } else if root.current-top + root.selected-height > list.height {
            list.content-y -= root.current-top + root.selected-height - list.height;
        }
    }

    function set-filter(value: int) {
        root.filter = value;
        root.filter-changed(value);
    }

    function start-rename() {
        if root.usable {
            root.rename-draft = root.current.named ? root.current.title : "";
            root.expanded = true;
            root.confirm-delete = false;
            root.editing = false;
            root.renaming = true;
        }
    }

    function start-edit() {
        if root.usable && root.current.kind == 0 && root.content-kind == 0 {
            root.edit-draft = root.content-text;
            root.expanded = true;
            root.confirm-delete = false;
            root.renaming = false;
            root.action-error = 0;
            root.editing = true;
        }
    }

    function start-mask() {
        if root.usable && root.content-kind == 0 {
            root.mask(root.selected);
        }
    }

    function request-delete() {
        if !root.has-selection {
            return;
        }
        if root.current.favorite {
            root.renaming = false;
            root.editing = false;
            root.expanded = true;
            root.confirm-delete = true;
        } else {
            root.delete(root.selected);
            footer.show-toast(@tr("entry deleted"));
        }
    }

    function toggle-favorite-selected() {
        if root.usable {
            root.toggle-favorite(root.selected);
        }
    }

    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.confirm-delete {
                    root.confirm-delete = false;
                } else if root.renaming {
                    root.renaming = false;
                } else if root.editing {
                    root.editing = false;
                    root.action-error = 0;
                } else {
                    root.dismissed();
                }
                return accept;
            }
            if root.renaming {
                return reject;
            }
            if root.editing {
                if event.modifiers.control && (event.text == "s" || event.text == "S") {
                    root.edit(root.selected, root.edit-draft);
                    return accept;
                }
                return reject;
            }
            if root.confirm-delete && event.text == Key.Return {
                root.confirm-delete = false;
                root.delete(root.selected);
                footer.show-toast(@tr("entry deleted"));
                return accept;
            }
            if event.text == Key.DownArrow {
                root.step(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.step(-1);
                return accept;
            }
            if event.text == Key.Return {
                if root.usable {
                    root.pick(root.selected, event.modifiers.control);
                }
                return accept;
            }
            if event.text == Key.F2 {
                root.start-rename();
                return accept;
            }
            if event.text == Key.Delete && root.query == "" {
                root.request-delete();
                return accept;
            }
            if event.text == Key.Tab && !event.modifiers.shift {
                root.set-filter(Math.mod(root.filter + 1, 4));
                return accept;
            }
            if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                root.set-filter(Math.mod(root.filter + 3, 4));
                return accept;
            }
            if event.modifiers.control && (event.text == "d" || event.text == "D") {
                root.toggle-favorite-selected();
                return accept;
            }
            if event.modifiers.control && (event.text == "e" || event.text == "E") {
                root.start-edit();
                return accept;
            }
            if event.modifiers.control && (event.text == "m" || event.text == "M") {
                root.start-mask();
                return accept;
            }
            if event.modifiers.control && event.text == "," {
                root.open-settings();
                return accept;
            }
            reject
        }

        frame := TabbedFrame {
            title: @tr("tex — clipboard");

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 12px;
                spacing: 12px;
                Text {
                    text: "›";
                    font-family: Tokens.mono-font;
                    font-size: Tokens.size-history-input;
                    font-weight: 500;
                    color: Tokens.action;
                    vertical-alignment: center;
                }
                input := TextField {
                    horizontal-stretch: 1;
                    height: 28px;
                    mono: true;
                    font-size: Tokens.size-history-input;
                    placeholder: @tr("search history");
                    text <=> root.query;
                    edited(text) => {
                        root.query-edited(text);
                    }
                }
                Rectangle {
                    height: 26px;
                    horizontal-stretch: 0;
                    border-radius: Tokens.radius-control;
                    border-width: Tokens.border-strong;
                    border-color: root.paused ? Tokens.warn : Tokens.control-off;
                    accessible-role: button;
                    accessible-label: root.paused ? @tr("PAUSED") : @tr("RECORDING");
                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 10px;
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                background: root.paused ? Tokens.warn : Tokens.action;
                            }
                        }
                        Text {
                            text: root.paused ? @tr("PAUSED") : @tr("RECORDING");
                            font-family: Tokens.mono-font;
                            font-size: Tokens.size-kicker;
                            font-weight: 600;
                            letter-spacing: Tokens.size-kicker * 0.06;
                            color: root.paused ? Tokens.warn-text : Tokens.ink-2;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-pause();
                        }
                    }
                }
            }

            TabBar {
                TabItem {
                    text: @tr("All");
                    active: root.filter == 0;
                    clicked => {
                        root.set-filter(0);
                    }
                }
                TabItem {
                    text: @tr("Favorites");
                    active: root.filter == 1;
                    clicked => {
                        root.set-filter(1);
                    }
                }
                TabItem {
                    text: @tr("Text");
                    active: root.filter == 2;
                    clicked => {
                        root.set-filter(2);
                    }
                }
                TabItem {
                    text: @tr("Images");
                    active: root.filter == 3;
                    clicked => {
                        root.set-filter(3);
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;

                list := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: cards.preferred-height;
                    changed content-y => {
                        if self.height - self.content-y >= self.content-height - 8 * root.card-height {
                            root.load-more();
                        }
                    }

                    cards := VerticalLayout {
                        width: list.width;
                        padding-top: 4px;
                        padding-bottom: 12px;
                        for row[index] in root.rows: Rectangle {
                            property <bool> day-start: index == 0 || !HistoryText.same-day(root.rows[index - 1], row);
                            property <bool> is-selected: index == root.selected;
                            property <bool> open: self.is-selected && root.expanded;

                            changed height => {
                                if self.is-selected {
                                    root.selected-height = self.height - (self.day-start ? root.day-height : 0px);
                                }
                            }

                            VerticalLayout {
                                if day-start: HorizontalLayout {
                                    height: root.day-height;
                                    padding-left: 20px;
                                    Kicker {
                                        text: HistoryText.day-label(row, root.current-year);
                                        vertical-alignment: bottom;
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    card := Rectangle {
                                        border-radius: Tokens.radius-card;
                                        background: is-selected ? Tokens.paper-2 : touch.has-hover ? Tokens.row-hover : transparent;
                                        border-width: is-selected ? Tokens.border-strong : 0px;
                                        border-color: Tokens.action;

                                        touch := TouchArea {
                                            clicked => {
                                                if is-selected {
                                                    if !root.renaming && !root.editing && !root.confirm-delete {
                                                        root.expanded = !root.expanded;
                                                    }
                                                } else {
                                                    root.select(index);
                                                }
                                            }
                                            double-clicked => {
                                                root.select(index);
                                                if !row.unreadable {
                                                    root.pick(index, false);
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            HorizontalLayout {
                                                min-height: root.card-height - 4px;
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 10px;
                                                Text {
                                                    width: 44px;
                                                    text: row.time;
                                                    font-family: Tokens.mono-font;
                                                    font-size: Tokens.size-meta;
                                                    color: Tokens.muted;
                                                    vertical-alignment: center;
                                                }
                                                if row.kind == 1 && !row.unreadable: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 44px;
                                                        height: 28px;
                                                        border-radius: 2px;
                                                        border-width: Tokens.border-control;
                                                        border-color: Tokens.control-off;
                                                        clip: true;
                                                        Image {
                                                            width: parent.width;
                                                            height: parent.height;
                                                            source: row.thumbnail;
                                                            image-fit: cover;
                                                        }
                                                    }
                                                }
                                                if row.kind != 1 || row.unreadable: Icon {
                                                    width: 15px;
                                                    source: row.unreadable ? Icons.warning : Icons.file-text;
                                                    tint: row.unreadable ? Tokens.muted : Tokens.type-file;
                                                }
                                                if !(open && root.renaming): Text {
                                                    horizontal-stretch: 1;
                                                    text: HistoryText.title(row);
                                                    font-size: Tokens.size-label;
                                                    font-italic: row.unreadable;
                                                    color: Tokens.ink;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                if open && root.renaming: VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    TextField {
                                                        height: 30px;
                                                        boxed: true;
                                                        font-weight: 500;
                                                        text <=> root.rename-draft;
                                                        init => {
                                                            self.focus();
                                                            self.select-all();
                                                        }
                                                        accepted => {
                                                            root.rename(root.selected, root.rename-draft);
                                                        }
                                                    }
                                                }
                                                if row.kind == 1 && !row.unreadable && row.width > 0: Text {
                                                    text: @tr("{0} × {1}", row.width, row.height);
                                                    font-family: Tokens.mono-font;
                                                    font-size: Tokens.size-kicker;
                                                    color: Tokens.muted;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle {
                                                    width: 16px;
                                                    if row.favorite: Icon {
                                                        width: 13px;
                                                        source: Icons.star;
                                                        tint: Tokens.action;
                                                    }
                                                }
                                            }

                                            if open: VerticalLayout {
                                                padding-left: 64px;
                                                padding-right: 12px;
                                                padding-bottom: 12px;
                                                spacing: 10px;

                                                if root.editing: TextArea {
                                                    height: 180px;
                                                    text <=> root.edit-draft;
                                                    init => {
                                                        self.focus();
                                                    }
                                                }
                                                if !root.editing && root.content-kind == 0: Rectangle {
                                                    height: min(180px, preview.preferred-height + 16px);
                                                    background: Tokens.field;
                                                    border-width: Tokens.border-control;
                                                    border-color: Tokens.border;
                                                    border-radius: Tokens.radius-control;
                                                    clip: true;
                                                    read := Flickable {
                                                        x: 10px;
                                                        y: 8px;
                                                        width: parent.width - 20px - Tokens.scrollbar-width;
                                                        height: parent.height - 16px;
                                                        content-height: preview.preferred-height;
                                                        preview := Text {
                                                            width: read.width;
                                                            text: root.content-preview;
                                                            font-family: Tokens.mono-font;
                                                            font-size: Tokens.size-body;
                                                            color: Tokens.ink;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                    ScrollBar {
                                                        x: parent.width - self.width - 2px;
                                                        height: parent.height;
                                                        viewport-y <=> read.content-y;
                                                        viewport-height: read.content-height;
                                                        visible-height: read.height;
                                                    }
                                                }
                                                if root.content-kind == 1: Image {
                                                    height: 180px;
                                                    source: root.content-image;
                                                    image-fit: contain;
                                                }
                                                if root.content-kind == 2: Text {
                                                    text: @tr("Unreadable entry");
                                                    font-size: Tokens.size-body;
                                                    color: Tokens.muted;
                                                }

                                                if root.content-kind == 0 || root.content-kind == 1: Text {
                                                    text: root.content-kind == 0
                                                        ? @tr("text · {0} characters · {1}", root.content-text.character-count, HistoryText.size(row))
                                                        : @tr("image · {0} × {1} · {2}", row.width, row.height, HistoryText.size(row));
                                                    font-family: Tokens.mono-font;
                                                    font-size: Tokens.size-kicker;
                                                    color: Tokens.muted;
                                                }

                                                if root.renaming: HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    Button { kind: ButtonKind.primary; key: "enter"; text: @tr("Save"); clicked => { root.rename(root.selected, root.rename-draft); } }
                                                    Button { key: "esc"; text: @tr("Cancel"); clicked => { root.renaming = false; } }
                                                }
                                                if root.editing: HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    Button { kind: ButtonKind.primary; key: "ctrl S"; text: @tr("Save"); clicked => { root.edit(root.selected, root.edit-draft); } }
                                                    Button { key: "esc"; text: @tr("Cancel"); clicked => { root.editing = false; root.action-error = 0; } }
                                                }
                                                if root.confirm-delete: HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: @tr("Delete this favorite?");
                                                        font-size: Tokens.size-label;
                                                        color: Tokens.ink;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        kind: ButtonKind.danger-filled;
                                                        key: "enter";
                                                        text: @tr("Yes");
                                                        clicked => {
                                                            root.confirm-delete = false;
                                                            root.delete(root.selected);
                                                            footer.show-toast(@tr("entry deleted"));
                                                        }
                                                    }
                                                    Button { key: "esc"; text: @tr("No"); clicked => { root.confirm-delete = false; } }
                                                }
                                                if !root.renaming && !root.editing && !root.confirm-delete: GridLayout {
                                                    spacing: 6px;
                                                    Button {
                                                        row: 0;
                                                        col: 0;
                                                        horizontal-stretch: 0;
                                                        kind: ButtonKind.primary;
                                                        key: "enter";
                                                        text: root.primary-action;
                                                        enabled: root.usable && root.content-kind != 2;
                                                        clicked => { root.pick(root.selected, false); }
                                                    }
                                                    Button {
                                                        row: 0;
                                                        col: 1;
                                                        horizontal-stretch: 0;
                                                        key: "ctrl enter";
                                                        text: root.other-action;
                                                        enabled: root.usable && root.content-kind != 2;
                                                        clicked => { root.pick(root.selected, true); }
                                                    }
                                                    Button {
                                                        row: 0;
                                                        col: 2;
                                                        horizontal-stretch: 0;
                                                        visible: root.current.kind == 0;
                                                        key: "ctrl M";
                                                        text: @tr("Mask");
                                                        enabled: root.usable && root.content-kind == 0;
                                                        clicked => { root.start-mask(); }
                                                    }
                                                    Button {
                                                        row: 1;
                                                        col: 0;
                                                        horizontal-stretch: 0;
                                                        key: "ctrl D";
                                                        text: root.current.favorite ? @tr("Unfavorite") : @tr("Favorite");
                                                        enabled: root.usable;
                                                        clicked => { root.toggle-favorite-selected(); }
                                                    }
                                                    Button {
                                                        row: 1;
                                                        col: 1;
                                                        horizontal-stretch: 0;
                                                        key: "F2";
                                                        text: @tr("Rename");
                                                        enabled: root.usable;
                                                        clicked => { root.start-rename(); }
                                                    }
                                                    Button {
                                                        row: 1;
                                                        col: 2;
                                                        horizontal-stretch: 0;
                                                        visible: root.current.kind == 0;
                                                        key: "ctrl E";
                                                        text: @tr("Edit");
                                                        enabled: root.usable && root.content-kind == 0;
                                                        clicked => { root.start-edit(); }
                                                    }
                                                    Rectangle {
                                                        row: 1;
                                                        col: 3;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Button {
                                                        row: 1;
                                                        col: 4;
                                                        horizontal-stretch: 0;
                                                        kind: ButtonKind.danger;
                                                        key: "del";
                                                        text: @tr("Delete");
                                                        clicked => { root.request-delete(); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width - 2px;
                    height: parent.height;
                    viewport-y <=> list.content-y;
                    viewport-height: list.content-height;
                    visible-height: list.height;
                }

                if root.rows.length == 0 && !root.searching: EmptyState {
                    width: parent.width;
                    height: parent.height;
                    art: Tokens.art-clipboard;
                    title: root.unavailable != "" ? @tr("Clipboard history unavailable: {0}", root.unavailable) : root.query != "" ? @tr("nothing for “{0}”", root.query) : @tr("nothing here.");
                    hint: root.unavailable != "" || root.query != "" ? "" : root.filter == 1 ? @tr("Mark entries with the star to keep them here.") : root.paused ? @tr("Capture is paused. Resume it with the PAUSED button.") : @tr("Copy anything and I'll keep it here.");
                }
            }

            footer := Footer {
                hints: @tr("enter {0} · ctrl enter {1} · del delete", root.primary-action-short, root.other-action-short);
                status: root.action-error == 1 ? @tr("Too large to save") : root.action-error == 2 ? @tr("Could not write to the clipboard") : root.paused ? @tr("new copies are not saved") : @tr("saving new copies");
                status-color: root.action-error != 0 ? Tokens.danger : root.paused ? Tokens.warn-text : Tokens.muted;
            }
        }
    }
}
