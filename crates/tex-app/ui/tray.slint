export component TexTray inherits SystemTrayIcon {
    in property <image> icon-image;
    in property <bool> paused;
    icon: root.icon-image;
    tooltip: "Tex";

    callback open();
    callback toggle();
    callback history();
    callback settings();
    callback about();
    callback toggle-pause();
    callback quit();

    clicked => {
        root.toggle();
    }

    Menu {
        MenuItem {
            title: @tr("Open Tex");
            activated => {
                root.open();
            }
        }

        MenuItem {
            title: @tr("Clipboard history");
            activated => {
                root.history();
            }
        }

        MenuItem {
            title: @tr("Settings");
            activated => {
                root.settings();
            }
        }

        MenuItem {
            title: @tr("About Tex");
            activated => {
                root.about();
            }
        }

        MenuItem {
            title: root.paused ? @tr("Resume capture") : @tr("Pause capture");
            activated => {
                root.toggle-pause();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Quit");
            activated => {
                root.quit();
            }
        }
    }
}
