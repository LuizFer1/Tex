import { Artwork } from "artwork.slint";

export component TexTray inherits SystemTrayIcon {
    in property <bool> paused;
    in property <string> update-version;
    icon: Artwork.mascot-tray;
    tooltip: "Tex";

    callback open();
    callback toggle();
    callback history();
    callback settings();
    callback about();
    callback toggle-pause();
    callback install-update();
    callback quit();

    clicked => {
        root.toggle();
    }

    Menu {
        MenuItem {
            title: @tr("Open Tex");
            activated => {
                root.open();
            }
        }

        MenuItem {
            title: @tr("Clipboard history");
            activated => {
                root.history();
            }
        }

        MenuItem {
            title: @tr("Settings");
            activated => {
                root.settings();
            }
        }

        MenuItem {
            title: @tr("About Tex");
            activated => {
                root.about();
            }
        }

        MenuItem {
            title: root.paused ? @tr("Resume capture") : @tr("Pause capture");
            activated => {
                root.toggle-pause();
            }
        }

        if root.update-version != "": MenuItem {
            title: @tr("Update to {0}", root.update-version);
            activated => {
                root.install-update();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Quit");
            activated => {
                root.quit();
            }
        }
    }
}
