export component TexTray inherits SystemTrayIcon {
    in property <image> icon-image;
    icon: root.icon-image;
    tooltip: "Tex";

    callback open();
    callback settings();
    callback about();
    callback quit();

    clicked => {
        root.open();
    }

    Menu {
        MenuItem {
            title: @tr("Open Tex");
            activated => {
                root.open();
            }
        }

        MenuItem {
            title: @tr("Settings");
            activated => {
                root.settings();
            }
        }

        MenuItem {
            title: @tr("About Tex");
            activated => {
                root.about();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Quit");
            activated => {
                root.quit();
            }
        }
    }
}
