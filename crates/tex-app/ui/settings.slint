import { Palette } from "std-widgets.slint";
import { Tokens } from "theme.slint";
import { Icons, ScrollBar, TabItem, Toggle, Segmented, Select, Section, SettingRow, Paragraph, ShortcutField, Button, ButtonKind, CheckBox, PathList, ConfirmButton, Notice, Footer, TitleButton, ResizeEdge } from "kit/kit.slint";
import { HistoryText } from "history.slint";
import { EntryRow, EntryList } from "settings-entries.slint";

export { EntryRow }

export struct DriveRow {
    letter: string,
    // 0 indexing, 1 ready, 2 failed
    state: int,
    percent: int,
    entries: string,
    reason: string,
}

export component SettingsWindow inherits Window {
    title: @tr("Tex Settings");
    icon: Tokens.app-icon;
    no-frame: true;
    preferred-width: 740px;
    preferred-height: 690px;
    min-width: 640px;
    min-height: 560px;
    background: Tokens.paper;
    default-font-family: Tokens.ui-font;

    in property <ColorScheme> scheme;
    in-out property <int> current-tab;
    in property <string> version;
    in property <bool> window-maximized;

    in-out property <int> language;
    in-out property <int> theme;
    in property <string> hotkey-text;
    in property <[string]> hotkey-keys;
    in-out property <bool> recording;
    // 0 none, 1 could not register (previous kept), 2 conflict, 3 could not register at startup
    in property <int> hotkey-error;
    in-out property <bool> windows-key;
    in property <string> winkey-error;
    in-out property <bool> start-with-windows;
    in-out property <bool> auto-update;
    in-out property <bool> remote-images;
    // 0 idle, 1 checking, 2 up to date, 3 downloading, 4 ready, 5 failed, 6 installing
    in property <int> update-state;
    in property <string> update-version;
    in-out property <int> popup-monitor;

    in-out property <int> keep-search;
    in-out property <bool> include-hidden;
    in-out property <bool> include-system;
    in property <[StandardListViewItem]> excluded;
    in-out property <int> selected-excluded: -1;
    in-out property <bool> show-apps;
    in-out property <bool> show-files;
    in-out property <bool> show-folders;
    in-out property <int> enter-action;
    in-out property <bool> calculator;
    in-out property <bool> suggestions;
    in property <[DriveRow]> drives;
    in property <bool> drives-unavailable;

    in property <string> history-hotkey-text;
    in property <[string]> history-hotkey-keys;
    in-out property <bool> history-recording;
    // 0 none, 1 could not register (previous kept), 2 used to open Tex, 3 could not register at startup
    in property <int> history-hotkey-error;
    in-out property <bool> paused;
    in-out property <bool> capture-text;
    in-out property <bool> capture-images;
    in-out property <int> item-size;
    in-out property <int> on-pick;
    // 0 by time, 1 by storage
    in-out property <int> cleanup;
    in-out property <int> cleanup-days;
    in-out property <int> cleanup-limit;
    in property <string> usage-value;
    in property <int> usage-unit;
    in-out property <bool> respect-exclusion;
    in property <[StandardListViewItem]> ignored-apps;
    in-out property <int> selected-ignored: -1;
    in-out property <bool> confirm-clear;
    in property <string> capture-error;
    in property <string> history-unavailable;

    in property <[EntryRow]> masks;
    // -1 when no row is being edited
    in-out property <int> editing-mask: -1;
    in-out property <string> edit-name;
    in-out property <string> edit-pattern;
    in-out property <string> new-name;
    in-out property <string> new-pattern;
    property <int> edit-error: root.masks.length >= 0 ? root.check-mask(root.editing-mask, root.edit-name, root.edit-pattern) : 0;
    property <int> new-error: root.masks.length >= 0 ? root.check-mask(-1, root.new-name, root.new-pattern) : 0;

    in-out property <bool> gen-formatted;
    in-out property <int> password-length;
    in-out property <bool> password-symbols;
    in property <[EntryRow]> generators;
    in-out property <int> editing-generator: -1;
    in-out property <string> gen-edit-name;
    in-out property <string> gen-edit-pattern;
    in-out property <string> gen-new-name;
    in-out property <string> gen-new-pattern;
    property <int> gen-edit-error: root.generators.length >= 0 ? root.check-generator(root.editing-generator, root.gen-edit-name, root.gen-edit-pattern) : 0;
    property <int> gen-new-error: root.generators.length >= 0 ? root.check-generator(-1, root.gen-new-name, root.gen-new-pattern) : 0;

    in property <string> save-error;

    // Questions waiting for an answer. Esc and a change of tab drop them all.
    property <int> mask-confirm: -1;
    property <int> generator-confirm: -1;
    property <bool> confirm-usage;
    property <bool> confirm-masks-restore;
    property <bool> confirm-generators-restore;

    property <[string]> tab-labels: [@tr("General"), @tr("Search"), @tr("Clipboard"), @tr("Masks"), @tr("Generators")];
    // The content keeps a readable width and stays centered in a wide window.
    property <length> gutter: 32px;
    property <length> column: 760px;
    property <length> select-width: 200px;
    out property <string> folder-picker-title: @tr("Choose a folder to ignore in search");
    out property <string> app-picker-title: @tr("Choose an app to ignore");
    out property <string> app-picker-filter: @tr("Programs");
    property <[string]> limit-labels: [@tr("{0} MB", 250), @tr("{0} MB", 500), @tr("{0} GB", 1), @tr("{0} GB", 2), @tr("{0} GB", 5)];

    callback edited();
    callback change-hotkey();
    callback reset-hotkey();
    callback shortcut-captured(string, bool, bool, bool, bool);
    callback cancel-recording();
    callback add-folder();
    callback remove-folder(int);
    callback refresh-drives();
    callback change-history-hotkey();
    callback reset-history-hotkey();
    callback history-shortcut-captured(string, bool, bool, bool, bool);
    callback cancel-history-recording();
    callback add-app();
    callback remove-app(int);
    callback clear-history();
    callback clear-usage();
    callback check-updates();
    callback install-update();
    callback redo-onboarding();
    // Index of the row being edited, or -1 for a new mask. 0 when it can be saved.
    pure callback check-mask(int, string, string) -> int;
    callback mask-add(string, string);
    callback mask-edit(int, string, string);
    callback mask-delete(int);
    callback masks-restore();
    pure callback check-generator(int, string, string) -> int;
    callback generator-add(string, string);
    callback generator-edit(int, string, string);
    callback generator-delete(int);
    callback generators-restore();

    pure function mask-message(code: int) -> string {
        if code == 1 {
            return @tr("Name is empty");
        }
        if code == 2 {
            return @tr("Name must be one word");
        }
        if code == 3 {
            return @tr("Another mask has this name");
        }
        if code == 11 {
            return @tr("Invalid regular expression");
        }
        if code == 12 {
            return @tr("Use groups of a fixed size, like {0}", "(\\d{3})");
        }
        if code == 13 {
            return @tr("Put a group in parentheses");
        }
        if code == 14 {
            return @tr("Put a separator between the groups");
        }
        if code == 15 {
            return @tr("Group too long");
        }
        return "";
    }

    pure function gen-message(code: int) -> string {
        if code == 1 {
            return @tr("Name is empty");
        }
        if code == 2 {
            return @tr("Name must be one word");
        }
        if code == 3 {
            return @tr("Another generator has this name");
        }
        if code == 11 {
            return @tr("Invalid regular expression");
        }
        if code == 12 {
            return @tr("Use parts of a fixed size, like {0}", "\\d{3}");
        }
        if code == 13 {
            return @tr("Add at least one random part, like {0}", "[A-Z]");
        }
        if code == 15 {
            return @tr("Too long: up to 256 characters per value");
        }
        if code == 16 {
            return @tr("A part has no character that can be typed");
        }
        return "";
    }

    pure function builtin-text(builtin: int) -> string {
        if builtin == 1 {
            return @tr("Valid CPF");
        }
        if builtin == 2 {
            return @tr("Valid CNPJ");
        }
        if builtin == 3 {
            return @tr("Valid alphanumeric CNPJ");
        }
        if builtin == 4 {
            return @tr("Password");
        }
        return "";
    }

    callback drag();
    callback resize(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    forward-focus: recorder;

    function step-tab(delta: int) {
        root.current-tab = Math.mod(root.current-tab + delta + root.tab-labels.length, root.tab-labels.length);
    }

    function scroll-by(delta: length) {
        flick.content-y = min(0px, max(flick.height - flick.content-height, flick.content-y - delta));
    }

    function drop-questions() {
        root.editing-mask = -1;
        root.editing-generator = -1;
        root.mask-confirm = -1;
        root.generator-confirm = -1;
        root.confirm-clear = false;
        root.confirm-usage = false;
        root.confirm-masks-restore = false;
        root.confirm-generators-restore = false;
    }

    /// Esc first gives up an edit or a question in progress; true when there was one.
    function dismiss() -> bool {
        if root.editing-mask >= 0 || root.editing-generator >= 0 || root.mask-confirm >= 0 || root.generator-confirm >= 0 || root.confirm-clear || root.confirm-usage || root.confirm-masks-restore || root.confirm-generators-restore {
            root.drop-questions();
            return true;
        }
        return false;
    }

    /// Called when the window is shown: no question is left from the last time and its keys
    /// work before the first click.
    public function take-focus() {
        root.drop-questions();
        recorder.focus();
    }

    changed current-tab => {
        flick.content-y = 0;
        root.drop-questions();
        if !tabs.has-focus {
            recorder.focus();
        }
        if self.current-tab == 1 {
            root.refresh-drives();
        }
    }

    // The edit fields are gone with their focus: the window takes it back.
    changed editing-mask => {
        if self.editing-mask < 0 && !tabs.has-focus {
            recorder.focus();
        }
    }

    changed editing-generator => {
        if self.editing-generator < 0 && !tabs.has-focus {
            recorder.focus();
        }
    }

    changed scheme => {
        Palette.color-scheme = self.scheme;
    }

    // Every key nothing else took ends here: the shortcut being recorded, Esc and the keys
    // that change tab or scroll. It is never a Tab stop.
    recorder := FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.recording || root.history-recording {
                return reject;
            }
            if event.modifiers.control && (event.text == Key.Tab || event.text == Key.Backtab) {
                root.step-tab(event.modifiers.shift || event.text == Key.Backtab ? -1 : 1);
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if root.recording || root.history-recording {
                if event.text == Key.Escape {
                    if root.recording {
                        root.cancel-recording();
                    } else {
                        root.cancel-history-recording();
                    }
                    return accept;
                }
                if root.recording {
                    root.shortcut-captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                } else {
                    root.history-shortcut-captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                }
                return accept;
            }
            if event.text == Key.Escape {
                if !root.dismiss() {
                    root.close-window();
                }
                return accept;
            }
            if event.text == Key.PageDown {
                root.scroll-by(flick.height - 60px);
                return accept;
            }
            if event.text == Key.PageUp {
                root.scroll-by(60px - flick.height);
                return accept;
            }
            reject
        }

        Rectangle {
            border-width: root.window-maximized ? 0px : Tokens.border-control;
            border-color: Tokens.border;

            VerticalLayout {
                padding: root.window-maximized ? 0px : Tokens.border-control;

                Rectangle {
                    height: 36px;
                    background: Tokens.paper-2;
                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.drag();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 4px;
                                clip: true;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: Tokens.app-icon;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Tex Settings");
                            font-size: Tokens.size-path;
                            color: Tokens.ink-2;
                            vertical-alignment: center;
                        }
                        TitleButton {
                            icon: Icons.minimize;
                            tip: @tr("Minimize");
                            clicked => {
                                root.minimize();
                            }
                        }
                        TitleButton {
                            icon: root.window-maximized ? Icons.restore : Icons.maximize;
                            tip: root.window-maximized ? @tr("Restore") : @tr("Maximize");
                            clicked => {
                                root.toggle-maximize();
                            }
                        }
                        TitleButton {
                            icon: Icons.close;
                            close: true;
                            tip: @tr("Close");
                            clicked => {
                                root.close-window();
                            }
                        }
                    }
                }

                Rectangle {
                    background: Tokens.paper-2;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Tokens.border;
                    }
                    // One Tab stop for the whole strip: the arrows move between the tabs.
                    tabs := FocusScope {
                        property <bool> keyboard;
                        focus-on-click: false;
                        accessible-role: tab-list;
                        key-pressed(event) => {
                            if event.text == Key.LeftArrow {
                                root.step-tab(-1);
                                return accept;
                            }
                            if event.text == Key.RightArrow {
                                root.step-tab(1);
                                return accept;
                            }
                            reject
                        }
                        focus-gained(reason) => {
                            self.keyboard = reason == FocusReason.tab-navigation;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-left: root.gutter - 10px;
                            padding-right: root.gutter - 10px;
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                horizontal-stretch: 10000;
                                max-width: root.column + 20px;
                                HorizontalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    for label[index] in root.tab-labels: TabItem {
                                        height: 38px;
                                        pad: 10px;
                                        number: "0" + (index + 1);
                                        text: label;
                                        font-size: Tokens.size-tab;
                                        active: root.current-tab == index;
                                        focused: tabs.has-focus && tabs.keyboard && root.current-tab == index;
                                        clicked => {
                                            root.current-tab = index;
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                if root.save-error != "": HorizontalLayout {
                    padding-top: 12px;
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Notice {
                        horizontal-stretch: 10000;
                        max-width: root.column;
                        danger: true;
                        text: @tr("Could not save the settings: {}", root.save-error);
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    flick := Flickable {
                        width: parent.width;
                        height: parent.height;
                        // The page's preferred height counts wrapped texts as one line, so the
                        // end of the content is read from where the layout put its last item.
                        content-height: page-end.y + 32px;
                        page := VerticalLayout {
                            x: (flick.width - self.width) / 2;
                            y: 0px;
                            width: min(flick.width, root.column + 2 * root.gutter);
                            height: self.preferred-height;
                            padding-top: 8px;
                            padding-left: root.gutter;
                            padding-right: root.gutter;
                            padding-bottom: 32px;

                            if root.current-tab == 0: VerticalLayout {
                                Rectangle {
                                    height: 22px;
                                }
                                Rectangle {
                                    border-radius: Tokens.radius-window;
                                    background: Tokens.banner;
                                    clip: true;
                                    HorizontalLayout {
                                        spacing: 18px;
                                        padding-right: 16px;
                                        Image {
                                            width: 96px;
                                            min-height: 108px;
                                            source: Tokens.art-banner;
                                            image-fit: cover;
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            spacing: 4px;
                                            Text {
                                                text: "TEX " + root.version;
                                                font-family: Tokens.mono-font;
                                                font-size: Tokens.size-kicker;
                                                font-weight: 600;
                                                letter-spacing: Tokens.size-kicker * 0.08;
                                                color: Tokens.banner-kicker;
                                            }
                                            Paragraph {
                                                text: @tr("Hi! I keep what you copy and find what you look for.");
                                                font-size: Tokens.size-banner;
                                                font-weight: 600;
                                                ink: Tokens.banner-ink;
                                            }
                                            Paragraph {
                                                text: root.paused
                                                    ? @tr("{0} searches · {1} opens the history · capture paused", root.hotkey-text, root.history-hotkey-text)
                                                    : @tr("{0} searches · {1} opens the history · capture on", root.hotkey-text, root.history-hotkey-text);
                                                ink: Tokens.banner-ink-2;
                                            }
                                        }
                                        if root.paused: VerticalLayout {
                                            alignment: center;
                                            Button {
                                                on-banner: true;
                                                text: @tr("Resume capture");
                                                clicked => {
                                                    root.paused = false;
                                                    root.edited();
                                                }
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Appearance");
                                    SettingRow {
                                        label: @tr("Language");
                                        Select {
                                            min-width: root.select-width;
                                            label: @tr("Language");
                                            options: [@tr("Follow system"), "Português (Brasil)", "English"];
                                            current-index <=> root.language;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Theme");
                                        separator: false;
                                        Segmented {
                                            label: @tr("Theme");
                                            options: [@tr("System"), @tr("Light"), @tr("Dark")];
                                            current-index <=> root.theme;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Open Tex");
                                    SettingRow {
                                        label: @tr("Shortcut to open Tex");
                                        description: root.recording ? @tr("Use at least one of Ctrl, Alt, Shift or Win plus a key.") : "";
                                        error: root.hotkey-error == 1 ? @tr("That shortcut is already used by another program. The previous one was kept.") : root.hotkey-error == 3 ? @tr("That shortcut is already used by another program, so it is not active. Choose another one.") : root.hotkey-error == 2 ? @tr("Already used to open the clipboard history") : "";
                                        ShortcutField {
                                            keys: root.hotkey-keys;
                                            recording: root.recording;
                                            enabled: !root.history-recording;
                                            reset-tip: @tr("Restore default ({0})", "Alt+Space");
                                            record => {
                                                root.change-hotkey();
                                                recorder.focus();
                                            }
                                            cancel => {
                                                root.cancel-recording();
                                            }
                                            reset => {
                                                root.reset-hotkey();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Open Tex with the Windows key");
                                        description: @tr("Win plus other keys keeps working, and Ctrl+Esc opens the Start menu. Does not work while an administrator window has focus.");
                                        error: root.winkey-error != "" ? @tr("Could not watch the Windows key: {}", root.winkey-error) : "";
                                        Toggle {
                                            label: @tr("Open Tex with the Windows key");
                                            checked <=> root.windows-key;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Popup monitor");
                                        separator: false;
                                        Select {
                                            min-width: root.select-width;
                                            label: @tr("Popup monitor");
                                            options: [@tr("Under the cursor"), @tr("Primary monitor")];
                                            current-index <=> root.popup-monitor;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("System");
                                    SettingRow {
                                        label: @tr("Start with Windows");
                                        Toggle {
                                            label: @tr("Start with Windows");
                                            checked <=> root.start-with-windows;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Setup questions");
                                        description: @tr("Answer the first-run questions again.");
                                        separator: false;
                                        Button {
                                            text: @tr("Redo");
                                            clicked => {
                                                root.redo-onboarding();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Updates");
                                    SettingRow {
                                        label: @tr("Check for updates automatically");
                                        description: @tr("Only asks Tex's page on GitHub for new versions. Nothing about you is sent.");
                                        Toggle {
                                            label: @tr("Check for updates automatically");
                                            checked <=> root.auto-update;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Version {0}", root.version);
                                        description: root.update-state == 1 ? @tr("Checking for updates…")
                                            : root.update-state == 2 ? @tr("Tex is up to date.")
                                            : root.update-state == 3 ? @tr("Downloading version {0}…", root.update-version)
                                            : root.update-state == 4 ? @tr("Version {0} is ready to install.", root.update-version)
                                            : root.update-state == 6 ? @tr("Installing version {0}…", root.update-version)
                                            : "";
                                        error: root.update-state == 5 ? @tr("Could not check for updates.") : "";
                                        separator: false;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            if root.update-state == 4: Button {
                                                kind: ButtonKind.primary;
                                                text: @tr("Update and restart");
                                                clicked => {
                                                    root.install-update();
                                                }
                                            }
                                            Button {
                                                text: @tr("Check now");
                                                enabled: root.update-state != 1 && root.update-state != 3 && root.update-state != 6;
                                                clicked => {
                                                    root.check-updates();
                                                }
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Reader");
                                    SettingRow {
                                        label: @tr("Load images from the internet");
                                        description: @tr("Markdown files can show pictures hosted online. Loading one tells that site you opened the file. Off by default.");
                                        separator: false;
                                        Toggle {
                                            label: @tr("Load images from the internet");
                                            checked <=> root.remote-images;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current-tab == 1: VerticalLayout {
                                if root.drives-unavailable: VerticalLayout {
                                    padding-top: 22px;
                                    Notice {
                                        text: @tr("Search service is not running.");
                                        Button {
                                            on-banner: true;
                                            text: @tr("Refresh");
                                            clicked => {
                                                root.refresh-drives();
                                            }
                                        }
                                    }
                                }
                                Section {
                                    title: @tr("Results");
                                    first: true;
                                    SettingRow {
                                        label: @tr("Categories shown");
                                        description: @tr("At least one option always stays on.");
                                        HorizontalLayout {
                                            spacing: 16px;
                                            CheckBox {
                                                text: @tr("Apps");
                                                checked <=> root.show-apps;
                                                enabled: !root.show-apps || root.show-files || root.show-folders;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                            CheckBox {
                                                text: @tr("Files");
                                                checked <=> root.show-files;
                                                enabled: !root.show-files || root.show-apps || root.show-folders;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                            CheckBox {
                                                text: @tr("Folders");
                                                checked <=> root.show-folders;
                                                enabled: !root.show-folders || root.show-apps || root.show-files;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Enter key");
                                        description: @tr("Ctrl+Enter does the other action.");
                                        Segmented {
                                            label: @tr("Enter key");
                                            options: [@tr("Open"), @tr("Show in folder")];
                                            current-index <=> root.enter-action;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Keep the last search for");
                                        separator: false;
                                        Select {
                                            min-width: root.select-width;
                                            label: @tr("Keep the last search for");
                                            options: [@tr("Never"), @tr("30 seconds"), @tr("1 minute"), @tr("5 minutes"), @tr("Always")];
                                            current-index <=> root.keep-search;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Extras");
                                    SettingRow {
                                        label: @tr("Calculator in search");
                                        description: @tr("Shows the result of calculations and conversions above the results.");
                                        Toggle {
                                            label: @tr("Calculator in search");
                                            checked <=> root.calculator;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Suggest most used apps");
                                        description: @tr("Shows the apps you open most through Tex when the search is empty.");
                                        Toggle {
                                            label: @tr("Suggest most used apps");
                                            checked <=> root.suggestions;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: root.confirm-usage ? @tr("Clear the usage history?") : @tr("Usage history");
                                        description: @tr("Clearing it forgets which apps you open most and lets the suggestions you removed show up again.");
                                        separator: false;
                                        ConfirmButton {
                                            kind: ButtonKind.secondary;
                                            text: @tr("Clear…");
                                            confirm-text: @tr("Clear");
                                            cancel-text: @tr("Cancel");
                                            armed <=> root.confirm-usage;
                                            confirmed => {
                                                root.clear-usage();
                                                footer.show-toast(@tr("usage history cleared"));
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("What is searched");
                                    SettingRow {
                                        label: @tr("Include hidden files and folders");
                                        Toggle {
                                            label: @tr("Include hidden files and folders");
                                            checked <=> root.include-hidden;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Include system files");
                                        Toggle {
                                            label: @tr("Include system files");
                                            checked <=> root.include-system;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Folders left out of the search");
                                        separator: false;
                                        Button {
                                            text: @tr("+ Add");
                                            clicked => {
                                                root.add-folder();
                                            }
                                        }
                                    }
                                    PathList {
                                        items: root.excluded;
                                        empty-text: @tr("no ignored folders");
                                        remove-text: @tr("Remove");
                                        remove(index) => {
                                            root.remove-folder(index);
                                            recorder.focus();
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Indexing");
                                    SettingRow {
                                        label: @tr("Indexed drives");
                                        separator: false;
                                        Button {
                                            text: @tr("Refresh");
                                            clicked => {
                                                root.refresh-drives();
                                            }
                                        }
                                    }
                                    if root.drives.length > 0: Rectangle {
                                        background: Tokens.field;
                                        border-width: Tokens.border-control;
                                        border-color: Tokens.border;
                                        border-radius: Tokens.radius-control;
                                        VerticalLayout {
                                            for drive[index] in root.drives: VerticalLayout {
                                                if index > 0: Rectangle {
                                                    height: 1px;
                                                    background: Tokens.border-2;
                                                }
                                                HorizontalLayout {
                                                    height: 36px;
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    spacing: 12px;
                                                    Text {
                                                        width: 24px;
                                                        text: drive.letter + ":";
                                                        font-family: Tokens.mono-font;
                                                        font-size: Tokens.size-body;
                                                        font-weight: 600;
                                                        color: Tokens.ink;
                                                        vertical-alignment: center;
                                                    }
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: center;
                                                        Rectangle {
                                                            height: 6px;
                                                            border-radius: 3px;
                                                            background: Tokens.border-2;
                                                            Rectangle {
                                                                x: 0px;
                                                                width: parent.width * (drive.state == 0 ? drive.percent / 100 : drive.state == 1 ? 1 : 0);
                                                                border-radius: 3px;
                                                                background: drive.state == 0 ? Tokens.highlight : Tokens.action;
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        width: 150px;
                                                        text: drive.state == 1 ? @tr("ready · {0}", drive.entries) : drive.state == 0 ? @tr("indexing {0}%", drive.percent) : @tr("failed");
                                                        font-family: Tokens.mono-font;
                                                        font-size: Tokens.size-path;
                                                        color: drive.state == 2 ? Tokens.danger : Tokens.muted;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: right;
                                                        overflow: elide;
                                                    }
                                                }
                                                if drive.state == 2 && drive.reason != "": VerticalLayout {
                                                    padding-left: 48px;
                                                    padding-right: 12px;
                                                    padding-bottom: 10px;
                                                    Text {
                                                        text: drive.reason;
                                                        font-size: Tokens.size-desc;
                                                        color: Tokens.danger;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current-tab == 2: VerticalLayout {
                                if root.history-unavailable != "": VerticalLayout {
                                    padding-top: 22px;
                                    Notice {
                                        danger: true;
                                        text: @tr("Clipboard history unavailable: {0}", root.history-unavailable);
                                    }
                                }
                                Section {
                                    title: @tr("History");
                                    first: true;
                                    SettingRow {
                                        label: @tr("Shortcut to open the clipboard history");
                                        description: root.history-recording ? @tr("Use at least one of Ctrl, Alt, Shift or Win plus a key.") : "";
                                        error: root.history-hotkey-error == 1 ? @tr("That shortcut is already used by another program. The previous one was kept.") : root.history-hotkey-error == 3 ? @tr("That shortcut is already used by another program, so it is not active. Choose another one.") : root.history-hotkey-error == 2 ? @tr("Already used to open Tex") : "";
                                        ShortcutField {
                                            keys: root.history-hotkey-keys;
                                            recording: root.history-recording;
                                            enabled: !root.recording;
                                            reset-tip: @tr("Restore default ({0})", "Alt+V");
                                            record => {
                                                root.change-history-hotkey();
                                                recorder.focus();
                                            }
                                            cancel => {
                                                root.cancel-history-recording();
                                            }
                                            reset => {
                                                root.reset-history-hotkey();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("When choosing an entry");
                                        separator: false;
                                        Segmented {
                                            label: @tr("When choosing an entry");
                                            options: [@tr("Copy only"), @tr("Copy and paste")];
                                            current-index <=> root.on-pick;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Capture");
                                    SettingRow {
                                        label: @tr("Pause capture");
                                        error: root.capture-error != "" ? @tr("Could not watch the clipboard: {0}", root.capture-error) : "";
                                        Toggle {
                                            label: @tr("Pause capture");
                                            checked <=> root.paused;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("What to capture");
                                        description: @tr("At least one option always stays on.");
                                        HorizontalLayout {
                                            spacing: 16px;
                                            CheckBox {
                                                text: @tr("Text");
                                                checked <=> root.capture-text;
                                                enabled: !root.capture-text || root.capture-images;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                            CheckBox {
                                                text: @tr("Images");
                                                checked <=> root.capture-images;
                                                enabled: !root.capture-images || root.capture-text;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Maximum size per entry");
                                        description: @tr("Larger copies are not saved.");
                                        separator: false;
                                        Select {
                                            min-width: root.select-width;
                                            label: @tr("Maximum size per entry");
                                            options: [@tr("{0} MB", 1), @tr("{0} MB", 5), @tr("{0} MB", 10), @tr("{0} MB", 25), @tr("{0} MB", 50)];
                                            current-index <=> root.item-size;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Cleanup");
                                    SettingRow {
                                        label: @tr("Automatic cleanup");
                                        Segmented {
                                            label: @tr("Automatic cleanup");
                                            options: [@tr("By time"), @tr("By storage")];
                                            current-index <=> root.cleanup;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    if root.cleanup == 0: SettingRow {
                                        label: @tr("Delete entries older than");
                                        description: @tr("Favorites are never deleted by cleanup and do not count toward the limit.");
                                        separator: false;
                                        Select {
                                            min-width: root.select-width;
                                            label: @tr("Delete entries older than");
                                            options: [@tr("3 days"), @tr("1 week"), @tr("1 month")];
                                            current-index <=> root.cleanup-days;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    if root.cleanup == 1: SettingRow {
                                        label: @tr("Storage limit");
                                        description: (root.usage-value != "" ? @tr("Using {0} of {1}", HistoryText.size-text(root.usage-value, root.usage-unit), root.limit-labels[root.cleanup-limit]) + " · " : "") + @tr("Favorites are never deleted by cleanup and do not count toward the limit.");
                                        separator: false;
                                        Select {
                                            min-width: root.select-width;
                                            label: @tr("Storage limit");
                                            options: root.limit-labels;
                                            current-index <=> root.cleanup-limit;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Privacy");
                                    SettingRow {
                                        label: @tr("Respect apps that ask not to be saved");
                                        description: @tr("Password managers and other apps can mark what they copy as private. Tex does not detect passwords on its own.");
                                        Toggle {
                                            label: @tr("Respect apps that ask not to be saved");
                                            checked <=> root.respect-exclusion;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Ignored apps");
                                        separator: false;
                                        Button {
                                            text: @tr("+ Add");
                                            clicked => {
                                                root.add-app();
                                            }
                                        }
                                    }
                                    PathList {
                                        items: root.ignored-apps;
                                        empty-text: @tr("no ignored apps");
                                        remove-text: @tr("Remove");
                                        remove(index) => {
                                            root.remove-app(index);
                                            recorder.focus();
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 28px;
                                }
                                Rectangle {
                                    border-width: Tokens.border-strong;
                                    border-color: Tokens.danger;
                                    border-radius: Tokens.radius-control;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: root.confirm-clear ? @tr("Delete all entries except favorites?") : @tr("Clear history");
                                                font-size: Tokens.size-label;
                                                font-weight: 500;
                                                color: Tokens.ink;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: @tr("Deletes every entry except favorites.");
                                                font-size: Tokens.size-desc;
                                                color: Tokens.muted;
                                                wrap: word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ConfirmButton {
                                                text: @tr("Clear…");
                                                confirm-text: @tr("Delete now");
                                                cancel-text: @tr("Cancel");
                                                armed <=> root.confirm-clear;
                                                confirmed => {
                                                    root.clear-history();
                                                    if root.history-unavailable == "" {
                                                        footer.show-toast(@tr("history cleared"));
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current-tab == 3: VerticalLayout {
                                Section {
                                    title: @tr("Available masks");
                                    description: @tr("Type clean or maskup in the search to take a mask off a text or to put one on. In the clipboard history, Ctrl+M does it with the selected entry.");
                                    first: true;
                                    EntryList {
                                        entries: root.masks;
                                        editing <=> root.editing-mask;
                                        confirming <=> root.mask-confirm;
                                        edit-name <=> root.edit-name;
                                        edit-pattern <=> root.edit-pattern;
                                        edit-error: root.edit-error;
                                        new-name <=> root.new-name;
                                        new-pattern <=> root.new-pattern;
                                        new-error: root.new-error;
                                        pattern-title: @tr("Regular expression");
                                        add-text: @tr("Add mask");
                                        delete-question: @tr("Delete this mask?");
                                        empty-title: @tr("No masks");
                                        empty-hint: @tr("Add a mask below or restore the default ones.");
                                        hint: @tr("Each mask is a name and a regular expression with groups of fixed size, like {0}.", "(\\d{3})");
                                        message(code) => {
                                            return root.mask-message(code);
                                        }
                                        add(name, pattern) => {
                                            root.mask-add(name, pattern);
                                        }
                                        save(index, name, pattern) => {
                                            root.mask-edit(index, name, pattern);
                                        }
                                        delete(index) => {
                                            root.mask-delete(index);
                                            footer.show-toast(@tr("mask deleted"));
                                            recorder.focus();
                                        }
                                        blur => {
                                            recorder.focus();
                                        }
                                    }
                                    SettingRow {
                                        label: root.confirm-masks-restore ? @tr("Replace the list with the default masks?") : @tr("Default masks");
                                        description: @tr("Brings back the masks Tex comes with. The ones you added or changed are lost.");
                                        separator: false;
                                        ConfirmButton {
                                            kind: ButtonKind.secondary;
                                            text: @tr("Restore…");
                                            confirm-text: @tr("Restore");
                                            cancel-text: @tr("Cancel");
                                            armed <=> root.confirm-masks-restore;
                                            confirmed => {
                                                root.masks-restore();
                                                footer.show-toast(@tr("defaults restored"));
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current-tab == 4: VerticalLayout {
                                Section {
                                    title: @tr("Options");
                                    first: true;
                                    SettingRow {
                                        label: @tr("CPF and CNPJ with punctuation");
                                        description: @tr("Off, they are generated with digits and letters only.");
                                        Toggle {
                                            label: @tr("CPF and CNPJ with punctuation");
                                            checked <=> root.gen-formatted;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Password length");
                                        Select {
                                            min-width: root.select-width;
                                            label: @tr("Password length");
                                            options: ["12", "16", "20", "24", "32", "64"];
                                            current-index <=> root.password-length;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Symbols in passwords");
                                        description: @tr("Uses {0}", "!@#$%&*-_=+?");
                                        separator: false;
                                        Toggle {
                                            label: @tr("Symbols in passwords");
                                            checked <=> root.password-symbols;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Available generators");
                                    description: @tr("Type {0} in the search to generate a value. A number after the name generates several, like {1}.", @tr("generate cpf"), @tr("generate cpf") + " 5");
                                    EntryList {
                                        entries: root.generators;
                                        editing <=> root.editing-generator;
                                        confirming <=> root.generator-confirm;
                                        edit-name <=> root.gen-edit-name;
                                        edit-pattern <=> root.gen-edit-pattern;
                                        edit-error: root.gen-edit-error;
                                        new-name <=> root.gen-new-name;
                                        new-pattern <=> root.gen-new-pattern;
                                        new-error: root.gen-new-error;
                                        pattern-title: @tr("What it generates");
                                        add-text: @tr("Add generator");
                                        delete-question: @tr("Delete this generator?");
                                        empty-title: @tr("No generators");
                                        empty-hint: @tr("Add a generator below or restore the default ones.");
                                        hint: @tr("Your own generators are a name and a regular expression of fixed size, like {0}.", "[A-Z]{3}\\d[A-Z]\\d{2}");
                                        message(code) => {
                                            return root.gen-message(code);
                                        }
                                        summary(builtin) => {
                                            return root.builtin-text(builtin);
                                        }
                                        add(name, pattern) => {
                                            root.generator-add(name, pattern);
                                        }
                                        save(index, name, pattern) => {
                                            root.generator-edit(index, name, pattern);
                                        }
                                        delete(index) => {
                                            root.generator-delete(index);
                                            footer.show-toast(@tr("generator deleted"));
                                            recorder.focus();
                                        }
                                        blur => {
                                            recorder.focus();
                                        }
                                    }
                                    SettingRow {
                                        label: root.confirm-generators-restore ? @tr("Replace the list with the default generators?") : @tr("Default generators");
                                        description: @tr("Brings back the generators Tex comes with. The ones you added or changed are lost.");
                                        separator: false;
                                        ConfirmButton {
                                            kind: ButtonKind.secondary;
                                            text: @tr("Restore…");
                                            confirm-text: @tr("Restore");
                                            cancel-text: @tr("Cancel");
                                            armed <=> root.confirm-generators-restore;
                                            confirmed => {
                                                root.generators-restore();
                                                footer.show-toast(@tr("defaults restored"));
                                            }
                                        }
                                    }
                                }
                            }

                            page-end := Rectangle {
                                height: 0px;
                            }
                        }
                    }
                    ScrollBar {
                        x: parent.width - self.width - 2px;
                        height: parent.height;
                        viewport-y <=> flick.content-y;
                        viewport-height: flick.content-height;
                        visible-height: flick.height;
                    }
                }

                footer := Footer {
                    padding-x: root.gutter;
                    hints: root.recording || root.history-recording ? @tr("press the new shortcut · esc cancels")
                        : root.editing-mask >= 0 || root.editing-generator >= 0 ? @tr("enter saves · esc cancels")
                        : @tr("ctrl tab switches tabs · esc closes");
                }
            }
        }

        if !root.window-maximized: Rectangle {
            ResizeEdge { x: 0px; y: 0px; width: parent.width; height: 6px; direction: 0; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: parent.height - 6px; width: parent.width; height: 6px; direction: 1; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 6px; y: 0px; width: 6px; height: parent.height; direction: 2; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 6px; height: parent.height; direction: 3; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: 0px; width: 10px; height: 10px; direction: 4; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 10px; height: 10px; direction: 5; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; direction: 6; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 10px; height: 10px; direction: 7; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
        }
    }
}
