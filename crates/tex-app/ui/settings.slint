import { Button, CheckBox, ComboBox, Palette, ScrollView, StandardListView, Switch, TabWidget, VerticalBox } from "std-widgets.slint";
import { HistoryText } from "history.slint";

export struct DriveRow {
    letter: string,
    // 0 indexing, 1 ready, 2 failed
    state: int,
    percent: int,
    entries: string,
    reason: string,
}

component Label inherits Text {
    vertical-alignment: center;
    horizontal-stretch: 1;
    wrap: word-wrap;
}

component Hint inherits Text {
    font-size: 11px;
    opacity: 0.7;
    wrap: word-wrap;
}

component Row inherits HorizontalLayout {
    spacing: 12px;
    alignment: stretch;
}

export component SettingsWindow inherits Window {
    title: @tr("Tex Settings");
    preferred-width: 560px;
    preferred-height: 640px;
    min-width: 460px;
    background: Palette.background;

    in property <ColorScheme> scheme;
    in-out property <int> current-tab;

    in-out property <int> language;
    in-out property <int> theme;
    in property <string> hotkey-text;
    in-out property <bool> recording;
    // 0 none, 1 could not register (previous kept), 2 conflict, 3 could not register at startup
    in property <int> hotkey-error;
    in-out property <bool> windows-key;
    in property <string> winkey-error;
    in-out property <bool> start-with-windows;
    in-out property <int> popup-monitor;

    in-out property <int> keep-search;
    in-out property <bool> include-hidden;
    in-out property <bool> include-system;
    in property <[StandardListViewItem]> excluded;
    in-out property <int> selected-excluded: -1;
    in-out property <bool> show-apps;
    in-out property <bool> show-files;
    in-out property <bool> show-folders;
    in-out property <int> enter-action;
    in property <[DriveRow]> drives;
    in property <bool> drives-unavailable;

    in property <string> history-hotkey-text;
    in-out property <bool> history-recording;
    // 0 none, 1 could not register (previous kept), 2 used to open Tex, 3 could not register at startup
    in property <int> history-hotkey-error;
    in-out property <bool> paused;
    in-out property <bool> capture-text;
    in-out property <bool> capture-images;
    in-out property <int> item-size;
    in-out property <int> on-pick;
    // 0 by time, 1 by storage
    in-out property <int> cleanup;
    in-out property <int> cleanup-days;
    in-out property <int> cleanup-limit;
    in property <string> usage-value;
    in property <int> usage-unit;
    in-out property <bool> respect-exclusion;
    in property <[StandardListViewItem]> ignored-apps;
    in-out property <int> selected-ignored: -1;
    in-out property <bool> confirm-clear;
    in property <string> capture-error;
    in property <string> history-unavailable;

    in property <string> save-error;
    out property <string> folder-picker-title: @tr("Choose a folder to ignore in search");
    out property <string> app-picker-title: @tr("Choose an app to ignore");
    out property <string> app-picker-filter: @tr("Programs");
    property <[string]> limit-labels: [@tr("{0} MB", 250), @tr("{0} MB", 500), @tr("{0} GB", 1), @tr("{0} GB", 2), @tr("{0} GB", 5)];

    callback edited();
    callback change-hotkey();
    callback reset-hotkey();
    callback shortcut-captured(string, bool, bool, bool, bool);
    callback cancel-recording();
    callback add-folder();
    callback remove-folder(int);
    callback refresh-drives();
    callback change-history-hotkey();
    callback reset-history-hotkey();
    callback history-shortcut-captured(string, bool, bool, bool, bool);
    callback cancel-history-recording();
    callback add-app();
    callback remove-app(int);
    callback clear-history();

    changed current-tab => {
        if self.current-tab == 1 {
            root.refresh-drives();
        }
    }

    changed scheme => {
        Palette.color-scheme = self.scheme;
    }

    recorder := FocusScope {
        enabled: root.recording || root.history-recording;
        key-pressed(event) => {
            if !root.recording && !root.history-recording {
                return reject;
            }
            if event.text == Key.Escape {
                if root.recording {
                    root.cancel-recording();
                } else {
                    root.cancel-history-recording();
                }
                return accept;
            }
            if root.recording {
                root.shortcut-captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            } else {
                root.history-shortcut-captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            }
            accept
        }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            TabWidget {
                current-index <=> root.current-tab;
                Tab {
                    title: @tr("General");
                    VerticalBox {
                        alignment: start;
                        spacing: 14px;

                        Row {
                            Label {
                                text: @tr("Language");
                            }

                            ComboBox {
                                width: 200px;
                                model: [@tr("Follow system"), "Português", "English"];
                                current-index <=> root.language;
                                selected => {
                                    root.edited();
                                }
                            }
                        }

                        Row {
                            Label {
                                text: @tr("Theme");
                            }

                            ComboBox {
                                width: 200px;
                                model: [@tr("Follow system"), @tr("Light"), @tr("Dark")];
                                current-index <=> root.theme;
                                selected => {
                                    root.edited();
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Row {
                                Label {
                                    text: @tr("Shortcut to open Tex");
                                }

                                Text {
                                    text: root.recording ? @tr("Press the new shortcut…") : root.hotkey-text;
                                    vertical-alignment: center;
                                    font-weight: 600;
                                }

                                Button {
                                    text: root.recording ? @tr("Cancel") : @tr("Change");
                                    enabled: !root.history-recording;
                                    clicked => {
                                        if root.recording {
                                            root.cancel-recording();
                                        } else {
                                            root.change-hotkey();
                                            recorder.focus();
                                        }
                                    }
                                }

                                Button {
                                    text: @tr("Reset");
                                    enabled: !root.recording && !root.history-recording;
                                    clicked => {
                                        root.reset-hotkey();
                                    }
                                }
                            }

                            if root.recording: Hint {
                                text: @tr("Use at least one of Ctrl, Alt, Shift or Win plus a key. Esc cancels.");
                            }
                            if root.hotkey-error == 1: Hint {
                                text: @tr("That shortcut is already used by another program. The previous one was kept.");
                                color: #d13438;
                                opacity: 1;
                            }
                            if root.hotkey-error == 3: Hint {
                                text: @tr("That shortcut is already used by another program, so it is not active. Choose another one.");
                                color: #d13438;
                                opacity: 1;
                            }
                            if root.hotkey-error == 2: Hint {
                                text: @tr("Already used to open the clipboard history");
                                color: #d13438;
                                opacity: 1;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Switch {
                                text: @tr("Open Tex with the Windows key");
                                checked <=> root.windows-key;
                                toggled => {
                                    root.edited();
                                }
                            }

                            Hint {
                                text: @tr("Win plus other keys keeps working, and Ctrl+Esc opens the Start menu. Does not work while an administrator window has focus.");
                            }

                            if root.winkey-error != "": Hint {
                                text: @tr("Could not watch the Windows key: {}", root.winkey-error);
                                color: #d13438;
                                opacity: 1;
                            }
                        }

                        Switch {
                            text: @tr("Start with Windows");
                            checked <=> root.start-with-windows;
                            toggled => {
                                root.edited();
                            }
                        }

                        Row {
                            Label {
                                text: @tr("Popup monitor");
                            }

                            ComboBox {
                                width: 200px;
                                model: [@tr("Under the cursor"), @tr("Primary monitor")];
                                current-index <=> root.popup-monitor;
                                selected => {
                                    root.edited();
                                }
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Search");
                    VerticalBox {
                        alignment: start;
                        spacing: 12px;

                        Row {
                            Label {
                                text: @tr("Keep the last search for");
                            }

                            ComboBox {
                                width: 200px;
                                model: [@tr("Never"), @tr("30 seconds"), @tr("1 minute"), @tr("5 minutes"), @tr("Always")];
                                current-index <=> root.keep-search;
                                selected => {
                                    root.edited();
                                }
                            }
                        }

                        Switch {
                            text: @tr("Include hidden files and folders");
                            checked <=> root.include-hidden;
                            toggled => {
                                root.edited();
                            }
                        }

                        Switch {
                            text: @tr("Include system files");
                            checked <=> root.include-system;
                            toggled => {
                                root.edited();
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Ignored folders");
                            }

                            StandardListView {
                                height: 96px;
                                model: root.excluded;
                                current-item <=> root.selected-excluded;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button {
                                    text: @tr("Add…");
                                    clicked => {
                                        root.add-folder();
                                    }
                                }

                                Button {
                                    text: @tr("Remove");
                                    enabled: root.selected-excluded >= 0 && root.selected-excluded < root.excluded.length;
                                    clicked => {
                                        root.remove-folder(root.selected-excluded);
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Categories shown");
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                CheckBox {
                                    text: @tr("Apps");
                                    checked <=> root.show-apps;
                                    enabled: !root.show-apps || root.show-files || root.show-folders;
                                    toggled => {
                                        root.edited();
                                    }
                                }

                                CheckBox {
                                    text: @tr("Files");
                                    checked <=> root.show-files;
                                    enabled: !root.show-files || root.show-apps || root.show-folders;
                                    toggled => {
                                        root.edited();
                                    }
                                }

                                CheckBox {
                                    text: @tr("Folders");
                                    checked <=> root.show-folders;
                                    enabled: !root.show-folders || root.show-apps || root.show-files;
                                    toggled => {
                                        root.edited();
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Row {
                                Label {
                                    text: @tr("Enter key");
                                }

                                ComboBox {
                                    width: 200px;
                                    model: [@tr("Open"), @tr("Show in folder")];
                                    current-index <=> root.enter-action;
                                    selected => {
                                        root.edited();
                                    }
                                }
                            }

                            Hint {
                                text: @tr("Ctrl+Enter does the other action.");
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Row {
                                Label {
                                    text: @tr("Indexed drives");
                                }

                                Button {
                                    text: @tr("Refresh");
                                    clicked => {
                                        root.refresh-drives();
                                    }
                                }
                            }

                            if root.drives-unavailable: Hint {
                                text: @tr("Search service is not running.");
                            }
                            for drive in root.drives: Text {
                                text: drive.letter + ":  " + (drive.state == 1 ? @tr("Ready, {} items", drive.entries) : drive.state == 0 ? @tr("Indexing {}%", drive.percent) : @tr("Failed: {}", drive.reason));
                                font-size: 12px;
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Clipboard");
                    ScrollView {
                        VerticalBox {
                            alignment: start;
                            spacing: 14px;

                            VerticalLayout {
                                spacing: 4px;
                                Row {
                                    Label {
                                        text: @tr("Shortcut to open the clipboard history");
                                    }

                                    Text {
                                        text: root.history-recording ? @tr("Press the new shortcut…") : root.history-hotkey-text;
                                        vertical-alignment: center;
                                        font-weight: 600;
                                    }

                                    Button {
                                        text: root.history-recording ? @tr("Cancel") : @tr("Change");
                                        enabled: !root.recording;
                                        clicked => {
                                            if root.history-recording {
                                                root.cancel-history-recording();
                                            } else {
                                                root.change-history-hotkey();
                                                recorder.focus();
                                            }
                                        }
                                    }

                                    Button {
                                        text: @tr("Reset");
                                        enabled: !root.recording && !root.history-recording;
                                        clicked => {
                                            root.reset-history-hotkey();
                                        }
                                    }
                                }

                                if root.history-recording: Hint {
                                    text: @tr("Use at least one of Ctrl, Alt, Shift or Win plus a key. Esc cancels.");
                                }
                                if root.history-hotkey-error == 1: Hint {
                                    text: @tr("That shortcut is already used by another program. The previous one was kept.");
                                    color: #d13438;
                                    opacity: 1;
                                }
                                if root.history-hotkey-error == 3: Hint {
                                    text: @tr("That shortcut is already used by another program, so it is not active. Choose another one.");
                                    color: #d13438;
                                    opacity: 1;
                                }
                                if root.history-hotkey-error == 2: Hint {
                                    text: @tr("Already used to open Tex");
                                    color: #d13438;
                                    opacity: 1;
                                }
                            }

                            Switch {
                                text: @tr("Pause capture");
                                checked <=> root.paused;
                                toggled => {
                                    root.edited();
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Capture");
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: start;
                                    CheckBox {
                                        text: @tr("Text");
                                        checked <=> root.capture-text;
                                        enabled: !root.capture-text || root.capture-images;
                                        toggled => {
                                            root.edited();
                                        }
                                    }

                                    CheckBox {
                                        text: @tr("Images");
                                        checked <=> root.capture-images;
                                        enabled: !root.capture-images || root.capture-text;
                                        toggled => {
                                            root.edited();
                                        }
                                    }
                                }
                            }

                            Row {
                                Label {
                                    text: @tr("Maximum size per entry");
                                }

                                ComboBox {
                                    width: 200px;
                                    model: [@tr("{0} MB", 1), @tr("{0} MB", 5), @tr("{0} MB", 10), @tr("{0} MB", 25), @tr("{0} MB", 50)];
                                    current-index <=> root.item-size;
                                    selected => {
                                        root.edited();
                                    }
                                }
                            }

                            Row {
                                Label {
                                    text: @tr("When choosing an entry");
                                }

                                ComboBox {
                                    width: 200px;
                                    model: [@tr("Copy only"), @tr("Copy and paste")];
                                    current-index <=> root.on-pick;
                                    selected => {
                                        root.edited();
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Row {
                                    Label {
                                        text: @tr("Automatic cleanup");
                                    }

                                    ComboBox {
                                        width: 200px;
                                        model: [@tr("By time"), @tr("By storage")];
                                        current-index <=> root.cleanup;
                                        selected => {
                                            root.edited();
                                        }
                                    }
                                }

                                if root.cleanup == 0: Row {
                                    Label {
                                        text: @tr("Delete entries older than");
                                    }

                                    ComboBox {
                                        width: 200px;
                                        model: [@tr("3 days"), @tr("1 week"), @tr("1 month")];
                                        current-index <=> root.cleanup-days;
                                        selected => {
                                            root.edited();
                                        }
                                    }
                                }
                                if root.cleanup == 1: Row {
                                    Label {
                                        text: @tr("Storage limit");
                                    }

                                    ComboBox {
                                        width: 200px;
                                        model: root.limit-labels;
                                        current-index <=> root.cleanup-limit;
                                        selected => {
                                            root.edited();
                                        }
                                    }
                                }
                                if root.cleanup == 1 && root.usage-value != "": Hint {
                                    text: @tr("Using {0} of {1}", HistoryText.size-text(root.usage-value, root.usage-unit), root.limit-labels[root.cleanup-limit]);
                                }
                                Hint {
                                    text: @tr("Favorites are never deleted by cleanup and do not count toward the limit.");
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Switch {
                                    text: @tr("Respect apps that ask not to be saved");
                                    checked <=> root.respect-exclusion;
                                    toggled => {
                                        root.edited();
                                    }
                                }

                                Hint {
                                    text: @tr("Password managers and other apps can mark what they copy as private. Tex does not detect passwords on its own.");
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Ignored apps");
                                }

                                StandardListView {
                                    height: 96px;
                                    model: root.ignored-apps;
                                    current-item <=> root.selected-ignored;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: @tr("Add…");
                                        clicked => {
                                            root.add-app();
                                        }
                                    }

                                    Button {
                                        text: @tr("Remove");
                                        enabled: root.selected-ignored >= 0 && root.selected-ignored < root.ignored-apps.length;
                                        clicked => {
                                            root.remove-app(root.selected-ignored);
                                        }
                                    }
                                }
                            }

                            if !root.confirm-clear: HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: @tr("Clear history");
                                    clicked => {
                                        root.confirm-clear = true;
                                    }
                                }
                            }
                            if root.confirm-clear: Row {
                                Label {
                                    text: @tr("Delete all entries except favorites?");
                                }

                                Button {
                                    text: @tr("Delete");
                                    clicked => {
                                        root.confirm-clear = false;
                                        root.clear-history();
                                    }
                                }

                                Button {
                                    text: @tr("Cancel");
                                    clicked => {
                                        root.confirm-clear = false;
                                    }
                                }
                            }

                            if root.capture-error != "": Hint {
                                text: @tr("Could not watch the clipboard: {0}", root.capture-error);
                                color: #d13438;
                                opacity: 1;
                            }
                            if root.history-unavailable != "": Hint {
                                text: @tr("Clipboard history unavailable: {0}", root.history-unavailable);
                                color: #d13438;
                                opacity: 1;
                            }
                        }
                    }
                }
            }

            if root.save-error != "": Text {
                text: @tr("Could not save the settings: {}", root.save-error);
                color: #d13438;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
