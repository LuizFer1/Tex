import { Palette } from "std-widgets.slint";
import { Tokens } from "theme.slint";
import { Icon, Icons, ScrollBar, TabItem, Toggle, Segmented, Select, Section, SettingRow, ShortcutField, Button, ButtonKind, CheckBox, PathList, TextLink, TextField, TitleButton, ResizeEdge } from "kit/kit.slint";
import { HistoryText } from "history.slint";

export struct DriveRow {
    letter: string,
    // 0 indexing, 1 ready, 2 failed
    state: int,
    percent: int,
    entries: string,
    reason: string,
}

// 0 when the mask works, else the code `mask-message` explains.
export struct MaskEntryRow {
    name: string,
    pattern: string,
    error: int,
}

export component SettingsWindow inherits Window {
    title: @tr("Tex Settings");
    icon: Tokens.app-icon;
    no-frame: true;
    preferred-width: 740px;
    preferred-height: 690px;
    min-width: 640px;
    min-height: 560px;
    background: Tokens.paper;
    default-font-family: Tokens.ui-font;

    in property <ColorScheme> scheme;
    in-out property <int> current-tab;
    in property <string> version;
    in property <bool> window-maximized;

    in-out property <int> language;
    in-out property <int> theme;
    in property <string> hotkey-text;
    in property <[string]> hotkey-keys;
    in-out property <bool> recording;
    // 0 none, 1 could not register (previous kept), 2 conflict, 3 could not register at startup
    in property <int> hotkey-error;
    in-out property <bool> windows-key;
    in property <string> winkey-error;
    in-out property <bool> start-with-windows;
    in-out property <bool> auto-update;
    in-out property <bool> remote-images;
    // 0 idle, 1 checking, 2 up to date, 3 downloading, 4 ready, 5 failed, 6 installing
    in property <int> update-state;
    in property <string> update-version;
    in-out property <int> popup-monitor;

    in-out property <int> keep-search;
    in-out property <bool> include-hidden;
    in-out property <bool> include-system;
    in property <[StandardListViewItem]> excluded;
    in-out property <int> selected-excluded: -1;
    in-out property <bool> show-apps;
    in-out property <bool> show-files;
    in-out property <bool> show-folders;
    in-out property <int> enter-action;
    in-out property <bool> calculator;
    in property <[DriveRow]> drives;
    in property <bool> drives-unavailable;

    in property <string> history-hotkey-text;
    in property <[string]> history-hotkey-keys;
    in-out property <bool> history-recording;
    // 0 none, 1 could not register (previous kept), 2 used to open Tex, 3 could not register at startup
    in property <int> history-hotkey-error;
    in-out property <bool> paused;
    in-out property <bool> capture-text;
    in-out property <bool> capture-images;
    in-out property <int> item-size;
    in-out property <int> on-pick;
    // 0 by time, 1 by storage
    in-out property <int> cleanup;
    in-out property <int> cleanup-days;
    in-out property <int> cleanup-limit;
    in property <string> usage-value;
    in property <int> usage-unit;
    in-out property <bool> respect-exclusion;
    in property <[StandardListViewItem]> ignored-apps;
    in-out property <int> selected-ignored: -1;
    in-out property <bool> confirm-clear;
    in property <string> capture-error;
    in property <string> history-unavailable;

    in property <[MaskEntryRow]> masks;
    // -1 when no row is being edited
    in-out property <int> editing-mask: -1;
    in-out property <string> edit-name;
    in-out property <string> edit-pattern;
    in-out property <string> new-name;
    in-out property <string> new-pattern;
    property <int> edit-error: root.check-mask(root.editing-mask, root.edit-name, root.edit-pattern);
    property <int> new-error: root.check-mask(-1, root.new-name, root.new-pattern);

    in property <string> save-error;
    out property <string> folder-picker-title: @tr("Choose a folder to ignore in search");
    out property <string> app-picker-title: @tr("Choose an app to ignore");
    out property <string> app-picker-filter: @tr("Programs");
    property <[string]> limit-labels: [@tr("{0} MB", 250), @tr("{0} MB", 500), @tr("{0} GB", 1), @tr("{0} GB", 2), @tr("{0} GB", 5)];

    callback edited();
    callback change-hotkey();
    callback reset-hotkey();
    callback shortcut-captured(string, bool, bool, bool, bool);
    callback cancel-recording();
    callback add-folder();
    callback remove-folder(int);
    callback refresh-drives();
    callback change-history-hotkey();
    callback reset-history-hotkey();
    callback history-shortcut-captured(string, bool, bool, bool, bool);
    callback cancel-history-recording();
    callback add-app();
    callback remove-app(int);
    callback clear-history();
    callback check-updates();
    callback install-update();
    callback redo-onboarding();
    // Index of the row being edited, or -1 for a new mask. 0 when it can be saved.
    pure callback check-mask(int, string, string) -> int;
    callback mask-add(string, string);
    callback mask-edit(int, string, string);
    callback mask-delete(int);
    callback masks-restore();

    pure function mask-message(code: int) -> string {
        if code == 1 {
            return @tr("Name is empty");
        }
        if code == 2 {
            return @tr("Name must be one word");
        }
        if code == 3 {
            return @tr("Another mask has this name");
        }
        if code == 11 {
            return @tr("Invalid regular expression");
        }
        if code == 12 {
            return @tr("Use groups of a fixed size, like {0}", "(\\d{3})");
        }
        if code == 13 {
            return @tr("Put a group in parentheses");
        }
        if code == 14 {
            return @tr("Put a separator between the groups");
        }
        if code == 15 {
            return @tr("Group too long");
        }
        return "";
    }

    callback drag();
    callback resize(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    changed current-tab => {
        flick.content-y = 0;
        if self.current-tab == 1 {
            root.refresh-drives();
        }
    }

    changed scheme => {
        Palette.color-scheme = self.scheme;
    }

    recorder := FocusScope {
        enabled: root.recording || root.history-recording;
        key-pressed(event) => {
            if !root.recording && !root.history-recording {
                return reject;
            }
            if event.text == Key.Escape {
                if root.recording {
                    root.cancel-recording();
                } else {
                    root.cancel-history-recording();
                }
                return accept;
            }
            if root.recording {
                root.shortcut-captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            } else {
                root.history-shortcut-captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            }
            accept
        }


        Rectangle {
            border-width: root.window-maximized ? 0px : Tokens.border-control;
            border-color: Tokens.border;

            VerticalLayout {
                padding: root.window-maximized ? 0px : Tokens.border-control;

                Rectangle {
                    height: 36px;
                    background: Tokens.paper-2;
                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.drag();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 4px;
                                clip: true;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: Tokens.app-icon;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Tex Settings");
                            font-size: Tokens.size-path;
                            color: Tokens.ink-2;
                            vertical-alignment: center;
                        }
                        TitleButton {
                            icon: Icons.minimize;
                            tip: @tr("Minimize");
                            clicked => {
                                root.minimize();
                            }
                        }
                        TitleButton {
                            icon: root.window-maximized ? Icons.restore : Icons.maximize;
                            tip: root.window-maximized ? @tr("Restore") : @tr("Maximize");
                            clicked => {
                                root.toggle-maximize();
                            }
                        }
                        TitleButton {
                            icon: Icons.close;
                            close: true;
                            tip: @tr("Close");
                            clicked => {
                                root.close-window();
                            }
                        }
                    }
                }

                Rectangle {
                    background: Tokens.paper-2;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Tokens.border;
                    }
                    HorizontalLayout {
                        padding-top: 18px;
                        padding-left: 32px;
                        padding-right: 32px;
                        spacing: 28px;
                        alignment: start;
                        TabItem {
                            number: "01";
                            text: @tr("General");
                            font-size: Tokens.size-tab;
                            active: root.current-tab == 0;
                            clicked => {
                                root.current-tab = 0;
                            }
                        }
                        TabItem {
                            number: "02";
                            text: @tr("Search");
                            font-size: Tokens.size-tab;
                            active: root.current-tab == 1;
                            clicked => {
                                root.current-tab = 1;
                            }
                        }
                        TabItem {
                            number: "03";
                            text: @tr("Clipboard");
                            font-size: Tokens.size-tab;
                            active: root.current-tab == 2;
                            clicked => {
                                root.current-tab = 2;
                            }
                        }
                        TabItem {
                            number: "04";
                            text: @tr("Masks");
                            font-size: Tokens.size-tab;
                            active: root.current-tab == 3;
                            clicked => {
                                root.current-tab = 3;
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    flick := Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-height: page.preferred-height;
                        page := VerticalLayout {
                            width: flick.width;
                            padding-top: 8px;
                            padding-left: 32px;
                            padding-right: 32px;
                            padding-bottom: 32px;

                            if root.current-tab == 0: VerticalLayout {
                                Rectangle {
                                    height: 22px;
                                }
                                Rectangle {
                                    height: 150px;
                                    border-radius: Tokens.radius-window;
                                    background: Tokens.banner;
                                    clip: true;
                                    HorizontalLayout {
                                        spacing: 18px;
                                        padding-right: 20px;
                                        Image {
                                            width: 132px;
                                            source: Tokens.art-banner;
                                            image-fit: cover;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: "TEX " + root.version + (root.paused ? " · " + @tr("Capture paused").to-uppercase() : "");
                                                font-family: Tokens.mono-font;
                                                font-size: Tokens.size-kicker;
                                                font-weight: 600;
                                                letter-spacing: Tokens.size-kicker * 0.08;
                                                color: Tokens.banner-kicker;
                                            }
                                            Text {
                                                text: @tr("Hi! I keep what you copy and find what you look for.");
                                                font-size: Tokens.size-banner;
                                                font-weight: 600;
                                                color: Tokens.banner-ink;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: root.paused
                                                    ? @tr("{0} searches · {1} opens the history · capture paused", root.hotkey-text, root.history-hotkey-text)
                                                    : @tr("{0} searches · {1} opens the history · capture on", root.hotkey-text, root.history-hotkey-text);
                                                font-size: Tokens.size-desc;
                                                color: Tokens.banner-ink-2;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Appearance");
                                    SettingRow {
                                        label: @tr("Language");
                                        Select {
                                            min-width: 220px;
                                            label: @tr("Language");
                                            options: [@tr("Follow system"), "Português (Brasil)", "English"];
                                            current-index <=> root.language;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Theme");
                                        separator: false;
                                        Segmented {
                                            label: @tr("Theme");
                                            options: [@tr("System"), @tr("Light"), @tr("Dark")];
                                            current-index <=> root.theme;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Open Tex");
                                    SettingRow {
                                        label: @tr("Shortcut to open Tex");
                                        description: root.recording ? @tr("Use at least one of Ctrl, Alt, Shift or Win plus a key. Esc cancels.") : "";
                                        error: root.hotkey-error == 1 ? @tr("That shortcut is already used by another program. The previous one was kept.") : root.hotkey-error == 3 ? @tr("That shortcut is already used by another program, so it is not active. Choose another one.") : root.hotkey-error == 2 ? @tr("Already used to open the clipboard history") : "";
                                        ShortcutField {
                                            keys: root.hotkey-keys;
                                            recording: root.recording;
                                            enabled: !root.history-recording;
                                            reset-tip: @tr("Restore default ({0})", "Alt+Space");
                                            record => {
                                                root.change-hotkey();
                                                recorder.focus();
                                            }
                                            cancel => {
                                                root.cancel-recording();
                                            }
                                            reset => {
                                                root.reset-hotkey();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Open Tex with the Windows key");
                                        description: @tr("Win plus other keys keeps working, and Ctrl+Esc opens the Start menu. Does not work while an administrator window has focus.");
                                        error: root.winkey-error != "" ? @tr("Could not watch the Windows key: {}", root.winkey-error) : "";
                                        Toggle {
                                            label: @tr("Open Tex with the Windows key");
                                            checked <=> root.windows-key;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Popup monitor");
                                        separator: false;
                                        Select {
                                            min-width: 220px;
                                            label: @tr("Popup monitor");
                                            options: [@tr("Under the cursor"), @tr("Primary monitor")];
                                            current-index <=> root.popup-monitor;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("System");
                                    SettingRow {
                                        label: @tr("Start with Windows");
                                        Toggle {
                                            label: @tr("Start with Windows");
                                            checked <=> root.start-with-windows;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Setup questions");
                                        description: @tr("Answer the first-run questions again.");
                                        separator: false;
                                        Button {
                                            text: @tr("Redo");
                                            clicked => {
                                                root.redo-onboarding();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Updates");
                                    SettingRow {
                                        label: @tr("Check for updates automatically");
                                        description: @tr("Only asks Tex's page on GitHub for new versions. Nothing about you is sent.");
                                        Toggle {
                                            label: @tr("Check for updates automatically");
                                            checked <=> root.auto-update;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: root.update-state == 1 ? @tr("Checking for updates…")
                                            : root.update-state == 2 ? @tr("Tex is up to date.")
                                            : root.update-state == 3 ? @tr("Downloading version {0}…", root.update-version)
                                            : root.update-state == 4 ? @tr("Version {0} is ready to install.", root.update-version)
                                            : root.update-state == 5 ? @tr("Could not check for updates.")
                                            : root.update-state == 6 ? @tr("Installing version {0}…", root.update-version)
                                            : @tr("Version {0}", root.version);
                                        separator: false;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            if root.update-state == 4: Button {
                                                kind: ButtonKind.primary;
                                                text: @tr("Update and restart");
                                                clicked => {
                                                    root.install-update();
                                                }
                                            }
                                            Button {
                                                text: @tr("Check now");
                                                enabled: root.update-state != 1 && root.update-state != 3 && root.update-state != 6;
                                                clicked => {
                                                    root.check-updates();
                                                }
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Reader");
                                    SettingRow {
                                        label: @tr("Load images from the internet");
                                        description: @tr("Markdown files can show pictures hosted online. Loading one tells that site you opened the file. Off by default.");
                                        separator: false;
                                        Toggle {
                                            label: @tr("Load images from the internet");
                                            checked <=> root.remote-images;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }
                            }

                            if root.current-tab == 1: VerticalLayout {
                                Section {
                                    title: @tr("Results");
                                    first: true;
                                    SettingRow {
                                        label: @tr("Categories shown");
                                        HorizontalLayout {
                                            spacing: 16px;
                                            CheckBox {
                                                text: @tr("Apps");
                                                checked <=> root.show-apps;
                                                enabled: !root.show-apps || root.show-files || root.show-folders;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                            CheckBox {
                                                text: @tr("Files");
                                                checked <=> root.show-files;
                                                enabled: !root.show-files || root.show-apps || root.show-folders;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                            CheckBox {
                                                text: @tr("Folders");
                                                checked <=> root.show-folders;
                                                enabled: !root.show-folders || root.show-apps || root.show-files;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Enter key");
                                        description: @tr("Ctrl+Enter does the other action.");
                                        Segmented {
                                            label: @tr("Enter key");
                                            options: [@tr("Open"), @tr("Show in folder")];
                                            current-index <=> root.enter-action;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Calculator in search");
                                        description: @tr("Shows the result of calculations and conversions above the results.");
                                        Toggle {
                                            label: @tr("Calculator in search");
                                            checked <=> root.calculator;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Keep the last search for");
                                        separator: false;
                                        Select {
                                            label: @tr("Keep the last search for");
                                            options: [@tr("Never"), @tr("30 seconds"), @tr("1 minute"), @tr("5 minutes"), @tr("Always")];
                                            current-index <=> root.keep-search;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Indexing");
                                    SettingRow {
                                        label: @tr("Include hidden files and folders");
                                        Toggle {
                                            label: @tr("Include hidden files and folders");
                                            checked <=> root.include-hidden;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Include system files");
                                        Toggle {
                                            label: @tr("Include system files");
                                            checked <=> root.include-system;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Indexed drives");
                                        separator: false;
                                        Button {
                                            text: @tr("Refresh");
                                            clicked => {
                                                root.refresh-drives();
                                            }
                                        }
                                    }
                                    if root.drives-unavailable: Text {
                                        text: @tr("Search service is not running.");
                                        font-size: Tokens.size-desc;
                                        color: Tokens.warn-text;
                                    }
                                    for drive in root.drives: HorizontalLayout {
                                        height: 28px;
                                        spacing: 12px;
                                        Text {
                                            width: 34px;
                                            text: drive.letter + ":";
                                            font-family: Tokens.mono-font;
                                            font-size: Tokens.size-label;
                                            font-weight: 600;
                                            color: Tokens.ink;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Rectangle {
                                                height: 6px;
                                                border-radius: 3px;
                                                background: Tokens.border-2;
                                                Rectangle {
                                                    x: 0px;
                                                    width: parent.width * (drive.state == 0 ? drive.percent / 100 : drive.state == 1 ? 1 : 0);
                                                    border-radius: 3px;
                                                    background: drive.state == 0 ? Tokens.highlight : Tokens.action;
                                                }
                                            }
                                        }
                                        Text {
                                            width: 170px;
                                            text: drive.state == 1 ? @tr("ready · {0}", drive.entries) : drive.state == 0 ? @tr("indexing {0}%", drive.percent) : @tr("failed: {0}", drive.reason);
                                            font-family: Tokens.mono-font;
                                            font-size: Tokens.size-path;
                                            color: drive.state == 2 ? Tokens.danger : Tokens.muted;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Ignored folders");
                                    SettingRow {
                                        label: @tr("Folders left out of the search");
                                        separator: false;
                                        Button {
                                            text: @tr("+ Add");
                                            clicked => {
                                                root.add-folder();
                                            }
                                        }
                                    }
                                    PathList {
                                        items: root.excluded;
                                        empty-text: @tr("no ignored folders");
                                        remove-text: @tr("remove");
                                        remove(index) => {
                                            root.remove-folder(index);
                                        }
                                    }
                                }
                            }

                            if root.current-tab == 2: VerticalLayout {
                                Section {
                                    title: @tr("Capture");
                                    first: true;
                                    SettingRow {
                                        label: @tr("Shortcut to open the clipboard history");
                                        description: root.history-recording ? @tr("Use at least one of Ctrl, Alt, Shift or Win plus a key. Esc cancels.") : "";
                                        error: root.history-hotkey-error == 1 ? @tr("That shortcut is already used by another program. The previous one was kept.") : root.history-hotkey-error == 3 ? @tr("That shortcut is already used by another program, so it is not active. Choose another one.") : root.history-hotkey-error == 2 ? @tr("Already used to open Tex") : "";
                                        ShortcutField {
                                            keys: root.history-hotkey-keys;
                                            recording: root.history-recording;
                                            enabled: !root.recording;
                                            reset-tip: @tr("Restore default ({0})", "Alt+V");
                                            record => {
                                                root.change-history-hotkey();
                                                recorder.focus();
                                            }
                                            cancel => {
                                                root.cancel-history-recording();
                                            }
                                            reset => {
                                                root.reset-history-hotkey();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Pause capture");
                                        error: root.capture-error != "" ? @tr("Could not watch the clipboard: {0}", root.capture-error) : "";
                                        Toggle {
                                            label: @tr("Pause capture");
                                            checked <=> root.paused;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Capture");
                                        HorizontalLayout {
                                            spacing: 16px;
                                            CheckBox {
                                                text: @tr("Text");
                                                checked <=> root.capture-text;
                                                enabled: !root.capture-text || root.capture-images;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                            CheckBox {
                                                text: @tr("Images");
                                                checked <=> root.capture-images;
                                                enabled: !root.capture-images || root.capture-text;
                                                toggled => {
                                                    root.edited();
                                                }
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Maximum size per entry");
                                        Select {
                                            label: @tr("Maximum size per entry");
                                            options: [@tr("{0} MB", 1), @tr("{0} MB", 5), @tr("{0} MB", 10), @tr("{0} MB", 25), @tr("{0} MB", 50)];
                                            current-index <=> root.item-size;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("When choosing an entry");
                                        separator: false;
                                        Segmented {
                                            label: @tr("When choosing an entry");
                                            options: [@tr("Copy only"), @tr("Copy and paste")];
                                            current-index <=> root.on-pick;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Cleanup");
                                    SettingRow {
                                        label: @tr("Automatic cleanup");
                                        Segmented {
                                            label: @tr("Automatic cleanup");
                                            options: [@tr("By time"), @tr("By storage")];
                                            current-index <=> root.cleanup;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    if root.cleanup == 0: SettingRow {
                                        label: @tr("Delete entries older than");
                                        description: @tr("Favorites are never deleted by cleanup and do not count toward the limit.");
                                        separator: false;
                                        Select {
                                            label: @tr("Delete entries older than");
                                            options: [@tr("3 days"), @tr("1 week"), @tr("1 month")];
                                            current-index <=> root.cleanup-days;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    if root.cleanup == 1: SettingRow {
                                        label: @tr("Storage limit");
                                        description: (root.usage-value != "" ? @tr("Using {0} of {1}", HistoryText.size-text(root.usage-value, root.usage-unit), root.limit-labels[root.cleanup-limit]) + " · " : "") + @tr("Favorites are never deleted by cleanup and do not count toward the limit.");
                                        separator: false;
                                        Select {
                                            label: @tr("Storage limit");
                                            options: root.limit-labels;
                                            current-index <=> root.cleanup-limit;
                                            selected => {
                                                root.edited();
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("Privacy");
                                    SettingRow {
                                        label: @tr("Respect apps that ask not to be saved");
                                        description: @tr("Password managers and other apps can mark what they copy as private. Tex does not detect passwords on its own.");
                                        Toggle {
                                            label: @tr("Respect apps that ask not to be saved");
                                            checked <=> root.respect-exclusion;
                                            toggled => {
                                                root.edited();
                                            }
                                        }
                                    }
                                    SettingRow {
                                        label: @tr("Ignored apps");
                                        separator: false;
                                        Button {
                                            text: @tr("+ Add");
                                            clicked => {
                                                root.add-app();
                                            }
                                        }
                                    }
                                    PathList {
                                        items: root.ignored-apps;
                                        empty-text: @tr("no ignored apps");
                                        remove-text: @tr("remove");
                                        remove(index) => {
                                            root.remove-app(index);
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 26px;
                                }
                                Rectangle {
                                    border-width: Tokens.border-strong;
                                    border-color: Tokens.danger;
                                    border-radius: Tokens.radius-control;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: root.confirm-clear ? @tr("Delete all entries except favorites?") : @tr("Clear history");
                                                font-size: Tokens.size-label;
                                                font-weight: 500;
                                                color: Tokens.ink;
                                                wrap: word-wrap;
                                            }
                                            if !root.confirm-clear: Text {
                                                text: @tr("Deletes every entry except favorites.");
                                                font-size: Tokens.size-desc;
                                                color: Tokens.muted;
                                                wrap: word-wrap;
                                            }
                                        }
                                        if !root.confirm-clear: VerticalLayout {
                                            alignment: center;
                                            Button {
                                                kind: ButtonKind.danger;
                                                text: @tr("Clear…");
                                                clicked => {
                                                    root.confirm-clear = true;
                                                }
                                            }
                                        }
                                        if root.confirm-clear: HorizontalLayout {
                                            spacing: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: @tr("Cancel");
                                                    clicked => {
                                                        root.confirm-clear = false;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    kind: ButtonKind.danger-filled;
                                                    text: @tr("Delete now");
                                                    clicked => {
                                                        root.confirm-clear = false;
                                                        root.clear-history();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.history-unavailable != "": Text {
                                    text: @tr("Clipboard history unavailable: {0}", root.history-unavailable);
                                    font-size: Tokens.size-desc;
                                    color: Tokens.danger;
                                    wrap: word-wrap;
                                }
                            }

                            if root.current-tab == 3: VerticalLayout {
                                Section {
                                    title: @tr("Masks");
                                    first: true;
                                    SettingRow {
                                        label: @tr("Current masks");
                                        description: @tr("Each mask is a name and a regular expression with groups of fixed size, like {0}.", "(\\d{3})");
                                        separator: false;
                                        Button {
                                            text: @tr("Restore defaults");
                                            clicked => {
                                                root.editing-mask = -1;
                                                root.masks-restore();
                                            }
                                        }
                                    }
                                    Rectangle {
                                        background: Tokens.field;
                                        border-width: Tokens.border-control;
                                        border-color: Tokens.border;
                                        border-radius: Tokens.radius-control;
                                        VerticalLayout {
                                            if root.masks.length == 0: HorizontalLayout {
                                                padding-left: 12px;
                                                height: 36px;
                                                Text {
                                                    text: @tr("no masks");
                                                    font-family: Tokens.mono-font;
                                                    font-size: Tokens.size-path;
                                                    color: Tokens.muted;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            for entry[index] in root.masks: VerticalLayout {
                                                if index > 0: Rectangle {
                                                    height: 1px;
                                                    background: Tokens.border-2;
                                                }
                                                VerticalLayout {
                                                    padding-top: 8px;
                                                    padding-bottom: 8px;
                                                    padding-left: 12px;
                                                    padding-right: 8px;
                                                    spacing: 6px;
                                                    if root.editing-mask != index: HorizontalLayout {
                                                        spacing: 10px;
                                                        Text {
                                                            width: 110px;
                                                            text: entry.name;
                                                            font-family: Tokens.mono-font;
                                                            font-size: Tokens.size-button;
                                                            font-weight: 600;
                                                            color: Tokens.ink;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            horizontal-stretch: 1;
                                                            text: entry.pattern;
                                                            font-family: Tokens.mono-font;
                                                            font-size: Tokens.size-path;
                                                            color: Tokens.muted;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                        Button {
                                                            text: @tr("Edit");
                                                            clicked => {
                                                                root.edit-name = entry.name;
                                                                root.edit-pattern = entry.pattern;
                                                                root.editing-mask = index;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            TextLink {
                                                                text: @tr("Delete");
                                                                clicked => {
                                                                    root.editing-mask = -1;
                                                                    root.mask-delete(index);
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if root.editing-mask == index: HorizontalLayout {
                                                        spacing: 8px;
                                                        TextField {
                                                            width: 120px;
                                                            height: 30px;
                                                            boxed: true;
                                                            mono: true;
                                                            placeholder: @tr("Name");
                                                            text <=> root.edit-name;
                                                        }
                                                        TextField {
                                                            horizontal-stretch: 1;
                                                            height: 30px;
                                                            boxed: true;
                                                            mono: true;
                                                            placeholder: @tr("Regular expression");
                                                            text <=> root.edit-pattern;
                                                        }
                                                        Button {
                                                            kind: ButtonKind.primary;
                                                            text: @tr("Save");
                                                            enabled: root.edit-error == 0;
                                                            clicked => {
                                                                root.mask-edit(index, root.edit-name, root.edit-pattern);
                                                            }
                                                        }
                                                        Button {
                                                            text: @tr("Cancel");
                                                            clicked => {
                                                                root.editing-mask = -1;
                                                            }
                                                        }
                                                    }
                                                    if root.editing-mask == index && root.edit-error != 0: Text {
                                                        text: root.mask-message(root.edit-error);
                                                        font-size: Tokens.size-desc;
                                                        color: Tokens.danger;
                                                    }
                                                    if root.editing-mask != index && entry.error != 0: Text {
                                                        text: root.mask-message(entry.error);
                                                        font-size: Tokens.size-desc;
                                                        color: Tokens.danger;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                Section {
                                    title: @tr("New mask");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        TextField {
                                            width: 120px;
                                            height: 30px;
                                            boxed: true;
                                            mono: true;
                                            placeholder: @tr("Name");
                                            text <=> root.new-name;
                                        }
                                        TextField {
                                            horizontal-stretch: 1;
                                            height: 30px;
                                            boxed: true;
                                            mono: true;
                                            placeholder: @tr("Regular expression");
                                            text <=> root.new-pattern;
                                        }
                                        Button {
                                            kind: ButtonKind.primary;
                                            text: @tr("Add mask");
                                            enabled: root.new-error == 0;
                                            clicked => {
                                                root.mask-add(root.new-name, root.new-pattern);
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 6px;
                                    }
                                    if (root.new-name != "" || root.new-pattern != "") && root.new-error != 0: Text {
                                        text: root.mask-message(root.new-error);
                                        font-size: Tokens.size-desc;
                                        color: Tokens.danger;
                                    }
                                }
                            }

                            if root.save-error != "": Text {
                                text: @tr("Could not save the settings: {}", root.save-error);
                                color: Tokens.danger;
                                font-size: Tokens.size-desc;
                                wrap: word-wrap;
                            }
                        }
                    }
                    ScrollBar {
                        x: parent.width - self.width - 2px;
                        height: parent.height;
                        viewport-y <=> flick.content-y;
                        viewport-height: flick.content-height;
                        visible-height: flick.height;
                    }
                }
            }
        }

        if !root.window-maximized: Rectangle {
            ResizeEdge { x: 0px; y: 0px; width: parent.width; height: 6px; direction: 0; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: parent.height - 6px; width: parent.width; height: 6px; direction: 1; mouse-cursor: ns-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 6px; y: 0px; width: 6px; height: parent.height; direction: 2; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 6px; height: parent.height; direction: 3; mouse-cursor: ew-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: 0px; width: 10px; height: 10px; direction: 4; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: 0px; width: 10px; height: 10px; direction: 5; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; direction: 6; mouse-cursor: nwse-resize; resize(d) => { root.resize(d); } }
            ResizeEdge { x: 0px; y: parent.height - 10px; width: 10px; height: 10px; direction: 7; mouse-cursor: nesw-resize; resize(d) => { root.resize(d); } }
        }
    }
}
