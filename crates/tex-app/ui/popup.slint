import { Tokens } from "theme.slint";
import { Icon, Icons, TextField, ScrollBar, TabItem, TabBar, TabbedFrame, Footer, EmptyState } from "kit/kit.slint";

export struct ResultRow {
    header: bool,
    title: string,
    folder: string,
    short-folder: string,
    path: string,
    is-dir: bool,
    is-app: bool,
    readable: bool,
    category: int,
    icon: image,
    has-icon: bool,
    file-icon: int,
    count: int,
}

export struct CalcAnswer {
    expression: string,
    result: string,
    copy: string,
    kind: int,
    place: string,
    weekday: int,
    offset-minutes: int,
}

export struct MaskCard {
    input: string,
    output: string,
    mask: string,
    count: int,
}

export struct MaskRow {
    header: bool,
    kind: int,
    index: int,
    label: string,
    detail: string,
}

component AnswerCard inherits Rectangle {
    in property <CalcAnswer> answer;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    callback hovered();
    property <string> weekday-name: root.answer.weekday == 1 ? @tr("Monday") : root.answer.weekday == 2 ? @tr("Tuesday") : root.answer.weekday == 3 ? @tr("Wednesday") : root.answer.weekday == 4 ? @tr("Thursday") : root.answer.weekday == 5 ? @tr("Friday") : root.answer.weekday == 6 ? @tr("Saturday") : @tr("Sunday");
    property <int> offset-abs: Math.abs(root.answer.offset-minutes);
    property <string> offset-text: (root.answer.offset-minutes < 0 ? "-" : "+") + Math.floor(root.offset-abs / 60) + " h" + (Math.mod(root.offset-abs, 60) > 0 ? " " + Math.mod(root.offset-abs, 60) + " min" : "");
    property <string> caption: root.answer.kind == 3 ? root.weekday-name : root.answer.kind == 4 && root.answer.place != "" ? root.answer.place + " · " + root.weekday-name + (root.answer.offset-minutes != 0 ? " · " + root.offset-text : "") : "";

    Rectangle {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        border-radius: Tokens.radius-card;
        background: root.selected ? Tokens.action : Tokens.paper-2;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 14px;
            Text {
                horizontal-stretch: 1;
                text: root.answer.expression;
                font-family: Tokens.mono-font;
                font-size: Tokens.size-result;
                color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: "→";
                font-family: Tokens.mono-font;
                font-size: Tokens.size-result;
                color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                vertical-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.answer.result;
                    font-family: Tokens.mono-font;
                    font-size: Tokens.size-search;
                    font-weight: 500;
                    color: root.selected ? Tokens.on-action : Tokens.ink;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                if root.caption != "": Text {
                    text: root.caption;
                    font-family: Tokens.mono-font;
                    font-size: Tokens.size-meta;
                    color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

component MaskCardView inherits Rectangle {
    in property <MaskCard> card;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    callback hovered();
    property <string> caption: root.card.count > 1 ? root.card.mask + " · " + root.card.count + " " + @tr("occurrences") : root.card.mask;

    Rectangle {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        border-radius: Tokens.radius-card;
        background: root.selected ? Tokens.action : Tokens.paper-2;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 14px;
            Text {
                horizontal-stretch: 1;
                text: root.card.input;
                font-family: Tokens.mono-font;
                font-size: Tokens.size-result;
                color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: "→";
                font-family: Tokens.mono-font;
                font-size: Tokens.size-result;
                color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                vertical-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.card.output;
                    font-family: Tokens.mono-font;
                    font-size: Tokens.size-search;
                    font-weight: 500;
                    color: root.selected ? Tokens.on-action : Tokens.ink;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                if root.caption != "": Text {
                    text: root.caption;
                    font-family: Tokens.mono-font;
                    font-size: Tokens.size-meta;
                    color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

component MaskItem inherits Rectangle {
    in property <MaskRow> item;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    callback hovered();

    if root.item.header: HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 10px;
        spacing: 10px;
        Text {
            text: (root.item.kind == 0 ? @tr("Masks") : @tr("Clipboard history")).to-uppercase();
            font-family: Tokens.mono-font;
            font-size: Tokens.size-kicker;
            font-weight: 500;
            letter-spacing: Tokens.size-kicker * 0.06;
            color: Tokens.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 1px;
                background: Tokens.border-2;
            }
        }
    }

    if !root.item.header: Rectangle {
        x: 8px;
        width: parent.width - 16px;
        border-radius: 4px;
        background: root.selected ? Tokens.action : transparent;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            Text {
                text: root.item.label;
                horizontal-stretch: 1;
                font-size: Tokens.size-result;
                color: root.selected ? Tokens.on-action : Tokens.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                width: 42%;
                text: root.item.detail;
                font-family: Tokens.mono-font;
                font-size: Tokens.size-meta;
                color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    TouchArea {
        enabled: !root.item.header;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

component ResultItem inherits Rectangle {
    in property <ResultRow> item;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    callback hovered();

    if root.item.header: HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 10px;
        spacing: 10px;
        Text {
            text: (root.item.category == 0 ? @tr("Apps") : root.item.category == 1 ? @tr("Folders") : @tr("Files")).to-uppercase() + " — " + (root.item.count < 10 ? "0" : "") + root.item.count;
            font-family: Tokens.mono-font;
            font-size: Tokens.size-kicker;
            font-weight: 500;
            letter-spacing: Tokens.size-kicker * 0.06;
            color: Tokens.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 1px;
                background: Tokens.border-2;
            }
        }
    }

    if !root.item.header: Rectangle {
        x: 8px;
        width: parent.width - 16px;
        border-radius: 4px;
        background: root.selected ? Tokens.action : transparent;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            Rectangle {
                width: 20px;
                if root.item.has-icon: Image {
                    width: 17px;
                    height: 17px;
                    source: root.item.icon;
                    image-fit: contain;
                }
                if !root.item.has-icon: Icon {
                    width: 17px;
                    height: 17px;
                    source: root.item.is-app ? Icons.app : root.item.is-dir ? Icons.folder : Icons.file-kind(root.item.file-icon);
                    tint: root.selected ? Tokens.on-action : root.item.is-app ? Tokens.type-app : root.item.is-dir ? Tokens.type-folder : Tokens.type-file;
                }
            }
            Text {
                text: root.item.title;
                horizontal-stretch: 1;
                font-size: Tokens.size-result;
                color: root.selected ? Tokens.on-action : Tokens.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                width: 42%;
                text: root.item.short-folder;
                font-family: Tokens.mono-font;
                font-size: Tokens.size-meta;
                color: root.selected ? Tokens.on-action-muted : Tokens.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: 22px;
                Icon {
                    width: 14px;
                    source: Icons.enter;
                    tint: root.selected ? Tokens.highlight : transparent;
                }
            }
        }
    }

    TouchArea {
        enabled: !root.item.header;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered();
            }
        }
    }
}

export component Popup inherits Window {
    title: "Tex";
    no-frame: true;
    always-on-top: true;
    width: 700px;
    height: frame.preferred-height;
    background: Tokens.paper;
    default-font-family: Tokens.ui-font;
    forward-focus: input;

    in-out property <string> query;
    in property <[ResultRow]> rows;
    in property <int> selected: -1;
    in property <string> status-indexing;
    in property <string> status-failed;
    in property <string> status-ready-letters;
    in property <string> status-ready-total;
    in property <bool> service-unavailable;
    in property <bool> searching;
    in property <bool> enter-reveals;
    in property <bool> has-answer;
    in property <CalcAnswer> answer;
    in property <bool> answer-selected;
    in property <bool> mask-mode;
    in property <bool> has-mask-card;
    in property <MaskCard> mask-card;
    in property <[MaskRow]> mask-rows;
    in property <int> mask-action;
    property <string> mask-hints: root.mask-action == 1 ? @tr("enter copy result · esc close") : root.mask-action == 2 ? @tr("enter choose mask · esc close") : @tr("esc close");
    property <length> answer-height: (root.has-answer || root.has-mask-card) ? 64px : 0px;
    property <bool> selected-readable: root.selected >= 0 && root.selected < root.rows.length && root.rows[root.selected].readable;
    property <string> base-hints: @tr("↑↓ navigate · enter {0} · ctrl enter {1} · esc close", root.enter-reveals ? root.reveal-text : root.open-text, root.enter-reveals ? root.open-text : root.reveal-text);
    in-out property <int> filter: 0;
    in property <bool> show-apps: true;
    in property <bool> show-files: true;
    in property <bool> show-folders: true;
    in property <ColorScheme> scheme;
    // Whether the query has more than spaces in it, set by the app on every edit.
    in-out property <bool> expanded;
    out property <length> tab-width: frame.tab-width;
    out property <length> tab-height: frame.tab-height;

    callback dismissed();
    callback query-edited(string);
    callback filter-changed(int);
    callback step(int);
    callback select(int);
    callback activate(int, bool);
    callback read(int);
    callback open-settings();
    callback select-answer();
    callback copy-answer();

    property <length> row-height: 36px;
    property <string> open-text: @tr("open");
    property <string> reveal-text: @tr("open location");
    property <string> status-text: root.service-unavailable ? @tr("search service stopped") : root.status-indexing != "" ? @tr("indexing {0}", root.status-indexing) : root.status-failed != "" ? @tr("unavailable: {0}", root.status-failed) : root.status-ready-letters != "" ? @tr("{0} · {1} items", root.status-ready-letters, root.status-ready-total) : "";

    public function reset() {
        root.query = "";
        root.filter = 0;
        root.expanded = false;
        input.focus();
    }

    public function restore() {
        input.focus();
        input.select-all();
    }

    public function cursor-to(offset: int) {
        input.cursor-to(offset);
    }

    function set-filter(value: int) {
        root.filter = value;
        root.filter-changed(value);
    }

    function shown(value: int) -> bool {
        return value == 0 || (value == 1 && root.show-apps) || (value == 2 && root.show-files) || (value == 3 && root.show-folders);
    }

    // Next visible filter going forward (step 1) or backward (step 3).
    function next-filter(step: int) -> int {
        if root.shown(Math.mod(root.filter + step, 4)) {
            return Math.mod(root.filter + step, 4);
        }
        if root.shown(Math.mod(root.filter + 2 * step, 4)) {
            return Math.mod(root.filter + 2 * step, 4);
        }
        if root.shown(Math.mod(root.filter + 3 * step, 4)) {
            return Math.mod(root.filter + 3 * step, 4);
        }
        return root.filter;
    }

    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.step(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.step(-1);
                return accept;
            }
            if event.text == Key.Return {
                if root.answer-selected {
                    if !event.modifiers.shift {
                        root.copy-answer();
                    }
                } else if event.modifiers.shift {
                    root.read(root.selected);
                } else {
                    root.activate(root.selected, event.modifiers.control);
                }
                return accept;
            }
            if event.text == Key.Tab && !event.modifiers.shift {
                root.set-filter(root.next-filter(1));
                return accept;
            }
            if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                root.set-filter(root.next-filter(3));
                return accept;
            }
            if event.text == "," && event.modifiers.control {
                root.open-settings();
                return accept;
            }
            reject
        }

        frame := TabbedFrame {
            title: @tr("tex — search");

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 18px;
                padding-bottom: 14px;
                spacing: 12px;
                Text {
                    text: "›";
                    font-family: Tokens.mono-font;
                    font-size: Tokens.size-search;
                    font-weight: 500;
                    color: Tokens.action;
                    vertical-alignment: center;
                }
                input := TextField {
                    horizontal-stretch: 1;
                    height: 34px;
                    mono: true;
                    font-size: Tokens.size-search;
                    placeholder: @tr("type to search");
                    text <=> root.query;
                    edited(text) => {
                        root.query-edited(text);
                    }
                }
            }

            TabBar {
                TabItem {
                    text: @tr("All");
                    active: root.filter == 0;
                    clicked => {
                        root.set-filter(0);
                    }
                }
                if root.show-apps: TabItem {
                    text: @tr("Apps");
                    active: root.filter == 1;
                    clicked => {
                        root.set-filter(1);
                    }
                }
                if root.show-files: TabItem {
                    text: @tr("Files");
                    active: root.filter == 2;
                    clicked => {
                        root.set-filter(2);
                    }
                }
                if root.show-folders: TabItem {
                    text: @tr("Folders");
                    active: root.filter == 3;
                    clicked => {
                        root.set-filter(3);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: "tab";
                    font-family: Tokens.mono-font;
                    font-size: Tokens.size-kicker;
                    color: Tokens.muted;
                    vertical-alignment: center;
                }
            }

            if root.expanded: Rectangle {
                height: 372px;

                if root.has-answer: AnswerCard {
                    y: 0px;
                    width: parent.width;
                    height: root.answer-height;
                    answer: root.answer;
                    selected: root.answer-selected;
                    clicked => {
                        root.select-answer();
                    }
                    double-clicked => {
                        root.copy-answer();
                    }
                    hovered => {
                        if !root.answer-selected {
                            root.select-answer();
                        }
                    }
                }

                if root.has-mask-card: MaskCardView {
                    y: 0px;
                    width: parent.width;
                    height: root.answer-height;
                    card: root.mask-card;
                    selected: root.answer-selected;
                    clicked => {
                        root.select-answer();
                    }
                    double-clicked => {
                        root.copy-answer();
                    }
                    hovered => {
                        if !root.answer-selected {
                            root.select-answer();
                        }
                    }
                }

                if root.rows.length > 0 || root.mask-rows.length > 0: Rectangle {
                    y: root.answer-height;
                    width: parent.width;
                    height: parent.height - root.answer-height;
                    list := Flickable {
                        property <int> current: root.selected;
                        property <length> current-top: 4px + self.current * root.row-height + self.content-y;
                        width: parent.width;
                        height: parent.height;
                        content-height: rows-layout.preferred-height;
                        property <[ResultRow]> model: root.rows;
                        property <[MaskRow]> mask-model: root.mask-rows;

                        changed model => {
                            self.content-y = 0;
                        }

                        changed mask-model => {
                            self.content-y = 0;
                        }

                        changed current => {
                            if self.current <= 1 {
                                self.content-y = 0;
                            } else if self.current-top < 0 {
                                self.content-y -= self.current-top;
                            } else if self.current-top + root.row-height > self.height {
                                self.content-y -= self.current-top + root.row-height - self.height;
                            }
                        }

                        rows-layout := VerticalLayout {
                            width: list.width;
                            padding-top: 4px;
                            padding-bottom: 10px;
                            for row[index] in root.rows: ResultItem {
                                height: root.row-height;
                                item: row;
                                selected: index == root.selected;
                                clicked => {
                                    root.select(index);
                                }
                                double-clicked => {
                                    root.activate(index, false);
                                }
                                hovered => {
                                    if index != root.selected {
                                        root.select(index);
                                    }
                                }
                            }
                            for row[index] in root.mask-rows: MaskItem {
                                height: root.row-height;
                                item: row;
                                selected: index == root.selected;
                                clicked => {
                                    root.select(index);
                                }
                                double-clicked => {
                                    root.activate(index, false);
                                }
                                hovered => {
                                    if index != root.selected && row.kind != 3 {
                                        root.select(index);
                                    }
                                }
                            }
                        }
                    }

                    ScrollBar {
                        x: parent.width - self.width - 2px;
                        height: parent.height;
                        viewport-y <=> list.content-y;
                        viewport-height: list.content-height;
                        visible-height: list.height;
                    }
                }

                if root.rows.length == 0 && !root.searching && !root.has-answer && !root.mask-mode: EmptyState {
                    art: Tokens.art-search;
                    title: @tr("nothing for “{0}”", root.query);
                    hint: @tr("Check the categories and ignored folders in Settings › Search.");
                }

                if root.mask-mode && root.mask-rows.length == 0 && !root.has-mask-card: Text {
                    y: 24px;
                    width: parent.width;
                    text: @tr("nothing to work on");
                    font-size: Tokens.size-body;
                    color: Tokens.muted;
                    horizontal-alignment: center;
                }
            }

            Footer {
                hints: root.mask-mode ? root.mask-hints : root.answer-selected ? @tr("enter copy result · esc close") : root.selected-readable ? @tr("{0} · shift enter read", root.base-hints) : root.base-hints;
                status: root.status-text;
                status-color: root.service-unavailable || root.status-failed != "" ? Tokens.warn-text : Tokens.muted;
            }
        }
    }
}
